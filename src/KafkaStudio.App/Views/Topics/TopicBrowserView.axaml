<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:KafkaStudio.App.ViewModels.Topics"
			 xmlns:topics="using:KafkaStudio.Core.Topics"
			 xmlns:conv="using:KafkaStudio.App.Converters"
			 x:Class="KafkaStudio.App.Views.Topics.TopicBrowserView"
			 x:DataType="vm:TopicBrowserViewModel"
			 x:Name="Root">

  <UserControl.Styles>
	<!-- Compact chrome so the toolbar takes as little vertical space as possible. -->
	<Style Selector="Border.toolbar">
	  <Setter Property="Background" Value="{DynamicResource CardBrush}" />
	  <Setter Property="CornerRadius" Value="8" />
	  <Setter Property="Padding" Value="8,5" />
	</Style>
	<Style Selector="Border.toolbar TextBox">
	  <Setter Property="MinHeight" Value="26" />
	  <Setter Property="Padding" Value="6,2" />
	  <Setter Property="Margin" Value="0,0,6,0" />
	</Style>
	<Style Selector="Border.toolbar ComboBox">
	  <Setter Property="MinHeight" Value="26" />
	  <Setter Property="Padding" Value="6,2" />
	  <Setter Property="Margin" Value="0,0,6,0" />
	</Style>
	<Style Selector="Border.toolbar Button">
	  <Setter Property="MinHeight" Value="26" />
	  <Setter Property="Padding" Value="10,3" />
	  <Setter Property="Margin" Value="0,0,6,0" />
	</Style>
	<Style Selector="Border.pane">
	  <Setter Property="Background" Value="{DynamicResource CardBrush}" />
	  <Setter Property="CornerRadius" Value="8" />
	  <Setter Property="Padding" Value="8" />
	</Style>
	<Style Selector="TextBlock.paneTitle">
	  <Setter Property="FontWeight" Value="SemiBold" />
	  <Setter Property="Foreground" Value="White" />
	  <Setter Property="FontSize" Value="12" />
	  <Setter Property="VerticalAlignment" Value="Center" />
	</Style>
	<Style Selector="GridSplitter">
	  <Setter Property="Background" Value="Transparent" />
	</Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*">

	<!-- Single-line primary toolbar: everything needed for day to day browsing. -->
	<Border Grid.Row="0" Classes="toolbar">
	  <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,2*,Auto">
		<ComboBox Grid.Column="0" Width="170"
				  ItemsSource="{Binding ConnectionNames}" SelectedItem="{Binding SelectedConnection}"
				  ToolTip.Tip="Connection" />
		<Button Grid.Column="1" Content="⟳" ToolTip.Tip="Refresh topics" Command="{Binding RefreshTopicsCommand}" />

		<Border Grid.Column="2" Width="1" Background="#33FFFFFF" Margin="2,2" />

		<TextBox Grid.Column="3" MinWidth="120" Text="{Binding TopicFilter}" Watermark="Filter topics…"
				 ToolTip.Tip="Filter the topic list (contains)" />

		<TextBox Grid.Column="4" Width="64" Text="{Binding ScanLimit, TargetNullValue=''}" Watermark="all"
				 ToolTip.Tip="Max messages to load" />
		<Button Grid.Column="5" Content="Load" Classes="primary" Command="{Binding ScanCommand}"
				ToolTip.Tip="Reload messages for the selected topic" />

		<Border Grid.Column="6" Width="1" Background="#33FFFFFF" Margin="2,2" />

		<TextBox Grid.Column="7" MinWidth="140" Text="{Binding MessageFilter}"
				 Watermark="Search loaded messages…" />

		<TextBlock Grid.Column="8" VerticalAlignment="Center" Classes="muted"
				   ToolTip.Tip="{Binding StatusMessage}">
		  <Run Text="{Binding MatchedMessageCount}" /><Run Text=" / " /><Run Text="{Binding TotalMessageCount}" />
		</TextBlock>
	  </Grid>
	</Border>

	<!-- Everything used occasionally lives behind one collapsed expander. -->
	<Expander Grid.Row="1" Header="Advanced — saved filters, cross-topic search, topic sets" Margin="0,4,0,0">
	  <Border Classes="toolbar" Margin="0,4,0,0">
		<StackPanel Spacing="6">
		  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
			<TextBlock Grid.Column="0" Text="Saved filters" VerticalAlignment="Center" Classes="muted" Width="86" />
			<ComboBox Grid.Column="1" ItemsSource="{Binding SavedTopicFilters}" SelectedItem="{Binding SelectedSavedTopicFilter}"
					  PlaceholderText="Select a saved topic filter…" HorizontalAlignment="Stretch" />
			<Button Grid.Column="2" Content="Save" Command="{Binding SaveTopicFilterCommand}" />
			<Button Grid.Column="3" Content="Remove" Command="{Binding RemoveSavedTopicFilterCommand}" />
		  </Grid>

		  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
			<TextBlock Grid.Column="0" Text="Find anywhere" VerticalAlignment="Center" Classes="muted" Width="86" />
			<TextBox Grid.Column="1" Text="{Binding GlobalSearchTerm}" Watermark="Search every loaded topic's messages (contains)…" />
			<Button Grid.Column="2" Content="Search all topics" Classes="primary" Command="{Binding GlobalSearchCommand}" />
			<Button Grid.Column="3" Content="Cancel" Command="{Binding CancelGlobalSearchCommand}" IsVisible="{Binding IsGlobalSearching}" />
		  </Grid>

		  <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
			<TextBlock Grid.Column="0" Text="Topic set" VerticalAlignment="Center" Classes="muted" Width="86" />
			<ComboBox Grid.Column="1" ItemsSource="{Binding SavedTopicSets}" SelectedItem="{Binding SelectedSavedTopicSet}"
					  PlaceholderText="(search every loaded topic)" HorizontalAlignment="Stretch">
			  <ComboBox.ItemTemplate>
				<DataTemplate x:DataType="topics:SavedTopicSet">
				  <TextBlock Text="{Binding Name}" />
				</DataTemplate>
			  </ComboBox.ItemTemplate>
			</ComboBox>
			<TextBox Grid.Column="2" Text="{Binding NewTopicSetName}" Watermark="New set name…" Width="140" />
			<Button Grid.Column="3" Content="Save results as set" Command="{Binding SaveSearchResultsAsTopicSetCommand}" />
			<Button Grid.Column="4" Content="Delete" Command="{Binding DeleteSavedTopicSetCommand}" />
		  </Grid>

		  <TextBlock Classes="muted" IsVisible="{Binding IsGlobalSearching}">
			<Run Text="Scanning topic " /><Run Text="{Binding GlobalSearchTopicsScanned}" /><Run Text=" / " /><Run Text="{Binding GlobalSearchTopicsTotal}" /><Run Text="…" />
		  </TextBlock>
		</StackPanel>
	  </Border>
	</Expander>

	<!-- Data area: takes all remaining space. Narrow, resizable topic list + wide message viewer. -->
	<Grid Grid.Row="2" Margin="0,6,0,0" ColumnDefinitions="260,6,*">

	  <Border Grid.Column="0" Classes="pane">
		<DockPanel>
		  <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
			<TextBlock Grid.Column="0" Classes="paneTitle">
			  <Run Text="Topics" /><Run Text=" " /><Run Text="{Binding Topics.Count}" Foreground="{DynamicResource MutedTextBrush}" />
			</TextBlock>
			<ProgressBar Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding IsLoadingTopics}" Width="16" Height="16" />
		  </Grid>
		  <ListBox ItemsSource="{Binding Topics}" SelectedItem="{Binding SelectedTopicRow}" DoubleTapped="OnTopicDoubleTapped">
			<ListBox.ItemTemplate>
			  <DataTemplate x:DataType="vm:TopicRowViewModel">
				<TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis" Margin="2,1">
				  <ToolTip.Tip>
					<TextBlock>
					  <Run Text="{Binding Name}" /><LineBreak /><Run Text="{Binding PartitionCount, TargetNullValue='…'}" /><Run Text=" partitions · " /><Run Text="{Binding TotalMessageCount, TargetNullValue='…'}" /><Run Text=" messages" />
					</TextBlock>
				  </ToolTip.Tip>
				</TextBlock>
			  </DataTemplate>
			</ListBox.ItemTemplate>
		  </ListBox>
		</DockPanel>
	  </Border>

	  <GridSplitter Grid.Column="1" ResizeDirection="Columns" Width="6" />

	  <Grid Grid.Column="2" RowDefinitions="*,Auto">

		<!-- Messages of the selected topic -->
		<Border Grid.Row="0" Classes="pane" IsVisible="{Binding !IsGlobalSearchActive}">
		  <DockPanel>
			<Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
			  <TextBlock Grid.Column="0" Classes="paneTitle" Text="Messages" Margin="0,0,8,0" />
			  <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
						 Text="{Binding SelectedTopic, TargetNullValue='(no topic selected)'}" />
			  <ProgressBar Grid.Column="2" IsIndeterminate="True" IsVisible="{Binding IsLoadingMessages}" Width="16" Height="16" />
			</Grid>
			<ScrollViewer>
			  <ItemsControl ItemsSource="{Binding ScannedMessages}">
				<ItemsControl.ItemTemplate>
				  <DataTemplate>
					<Border Padding="8,6" Margin="0,0,0,4" Background="{DynamicResource SidebarBrush}" CornerRadius="6">
					  <StackPanel Spacing="2">
						<SelectableTextBlock Classes="muted">
						  <Run Text="offset " /><Run Text="{Binding Offset}" /><Run Text=" · partition " /><Run Text="{Binding Partition}" /><Run Text=" · key " /><Run Text="{Binding Key}" />
						</SelectableTextBlock>
						<SelectableTextBlock Inlines="{Binding PrettyValue, Converter={x:Static conv:JsonInlinesConverter.Instance}}" Foreground="White" TextWrapping="Wrap" FontFamily="Consolas,monospace" FontSize="12" />
					  </StackPanel>
					</Border>
				  </DataTemplate>
				</ItemsControl.ItemTemplate>
			  </ItemsControl>
			</ScrollViewer>
		  </DockPanel>
		</Border>

		<!-- Cross-topic search results reuse the same real estate instead of stacking below it. -->
		<Border Grid.Row="0" Classes="pane" IsVisible="{Binding IsGlobalSearchActive}">
		  <DockPanel>
			<StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,6">
			  <TextBlock Classes="paneTitle">
				<Run Text="Search results" /><Run Text=" · " Foreground="{DynamicResource MutedTextBrush}" /><Run Text="{Binding GlobalSearchResults.Count}" /><Run Text=" total" Foreground="{DynamicResource MutedTextBrush}" />
			  </TextBlock>
			  <ItemsControl ItemsSource="{Binding GlobalSearchResultsByTopic}" IsVisible="{Binding GlobalSearchResultsByTopic.Count}">
				<ItemsControl.ItemsPanel>
				  <ItemsPanelTemplate>
					<WrapPanel Orientation="Horizontal" />
				  </ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
				  <DataTemplate x:DataType="vm:TopicHitCount">
					<Border Classes="chip" Margin="0,0,4,4"
							Cursor="Hand" ToolTip.Tip="Click to filter results to this topic — click again to clear"
							Tapped="OnTopicHitCountTapped" Classes.selected="{Binding IsSelected}">
					  <TextBlock FontSize="11">
						<Run Text="{Binding Topic}" Foreground="{DynamicResource AccentBrush}" /><Run Text=" · " Foreground="{DynamicResource MutedTextBrush}" /><Run Text="{Binding Count}" FontWeight="SemiBold" Foreground="White" />
					  </TextBlock>
					</Border>
				  </DataTemplate>
				</ItemsControl.ItemTemplate>
			  </ItemsControl>
			</StackPanel>
			<ScrollViewer>
			  <ItemsControl ItemsSource="{Binding FilteredGlobalSearchResults}">
				<ItemsControl.ItemTemplate>
				  <DataTemplate x:DataType="vm:GlobalSearchHit">
					<Border Padding="8,6" Margin="0,0,0,4" Background="{DynamicResource SidebarBrush}" CornerRadius="6"
							DoubleTapped="OnGlobalSearchHitDoubleTapped">
					  <StackPanel Spacing="2">
						<Grid ColumnDefinitions="*,Auto">
						  <SelectableTextBlock Grid.Column="0" Classes="muted">
							<Run Text="topic " FontWeight="SemiBold" /><Run Text="{Binding Topic}" Foreground="{DynamicResource AccentBrush}" /><Run Text=" · offset " /><Run Text="{Binding Message.Offset}" /><Run Text=" · key " /><Run Text="{Binding Message.Key}" />
						  </SelectableTextBlock>
						  <Button Grid.Column="1" Content="Compare" Padding="6,2"
								  Command="{Binding #Root.DataContext.AddToComparisonCommand}"
								  CommandParameter="{Binding}" />
						</Grid>
						<SelectableTextBlock Inlines="{Binding Message.PrettyValue, Converter={x:Static conv:JsonInlinesConverter.Instance}}" Foreground="White" TextWrapping="Wrap" FontFamily="Consolas,monospace" FontSize="12" />
					  </StackPanel>
					</Border>
				  </DataTemplate>
				</ItemsControl.ItemTemplate>
			  </ItemsControl>
			</ScrollViewer>
		  </DockPanel>
		</Border>

		<!-- Pinned comparison strip: only appears when something is pinned. -->
		<Border Grid.Row="1" Classes="pane" Margin="0,6,0,0" MaxHeight="260" IsVisible="{Binding ComparisonMessages.Count}">
		  <DockPanel>
			<Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
			  <TextBlock Grid.Column="0" Classes="paneTitle" Text="Compare messages" />
			  <Button Grid.Column="1" Content="Clear all" Command="{Binding ClearComparisonCommand}" Padding="6,2" />
			</Grid>
			<ScrollViewer>
			  <ItemsControl ItemsSource="{Binding ComparisonMessages}">
				<ItemsControl.ItemsPanel>
				  <ItemsPanelTemplate>
					<WrapPanel Orientation="Horizontal" />
				  </ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
				  <DataTemplate x:DataType="vm:ComparisonEntry">
					<Border Padding="8" Margin="0,0,6,6" Width="320" Background="{DynamicResource SidebarBrush}" CornerRadius="6">
					  <StackPanel Spacing="3">
						<Grid ColumnDefinitions="*,Auto">
						  <SelectableTextBlock Grid.Column="0" Classes="muted">
							<Run Text="topic " FontWeight="SemiBold" /><Run Text="{Binding Topic}" Foreground="{DynamicResource AccentBrush}" /><Run Text=" · offset " /><Run Text="{Binding Message.Offset}" /><Run Text=" · key " /><Run Text="{Binding Message.Key}" />
						  </SelectableTextBlock>
						  <Button Grid.Column="1" Content="✕" Padding="6,2"
								  Command="{Binding #Root.DataContext.RemoveFromComparisonCommand}"
								  CommandParameter="{Binding}" />
						</Grid>
						<SelectableTextBlock Inlines="{Binding Message.PrettyValue, Converter={x:Static conv:JsonInlinesConverter.Instance}}" Foreground="White" TextWrapping="Wrap" FontFamily="Consolas,monospace" FontSize="12" />
					  </StackPanel>
					</Border>
				  </DataTemplate>
				</ItemsControl.ItemTemplate>
			  </ItemsControl>
			</ScrollViewer>
		  </DockPanel>
		</Border>
	  </Grid>
	</Grid>
  </Grid>
</UserControl>
