<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KafkaStudio.App.ViewModels.Topics"
             x:Class="KafkaStudio.App.Views.Topics.TopicBrowserView"
             x:DataType="vm:TopicBrowserViewModel">

  <Grid RowDefinitions="Auto,Auto,*" Margin="0">
    <TextBlock Grid.Row="0" Text="Topics" Classes="h1" Foreground="White" Margin="0,0,0,16" />

    <Border Grid.Row="1" Classes="card" Margin="0,0,0,16">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
          <TextBlock Grid.Column="0" Text="Connection" VerticalAlignment="Center" Classes="muted" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding ConnectionNames}" SelectedItem="{Binding SelectedConnection}" HorizontalAlignment="Stretch" />
          <Button Grid.Column="2" Content="Refresh topics" Command="{Binding RefreshTopicsCommand}" />
        </Grid>

        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
          <TextBlock Grid.Column="0" Text="Scan topic" VerticalAlignment="Center" Classes="muted" />
          <TextBox Grid.Column="1" Text="{Binding SelectedTopic}" Watermark="topic name" />
          <TextBox Grid.Column="2" Text="{Binding ScanLimit}" Width="80" Watermark="limit" />
          <Button Grid.Column="3" Content="Scan from beginning" Classes="primary" Command="{Binding ScanCommand}" />
        </Grid>

        <TextBlock Text="{Binding StatusMessage}" Classes="muted" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="1*,1.4*" ColumnSpacing="16">
      <Border Grid.Column="0" Classes="card">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Topics" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Topics}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TopicRowViewModel">
                  <Border Padding="8" Margin="0,0,0,4">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" Foreground="White" />
                      <TextBlock Classes="muted">
                        <Run Text="{Binding PartitionCount}" /><Run Text=" partitions, " /><Run Text="{Binding TotalMessageCount}" /><Run Text=" messages" />
                      </TextBlock>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Classes="card">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Scanned messages" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding ScannedMessages}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="8" Margin="0,0,0,4" Background="{DynamicResource SidebarBrush}" CornerRadius="6">
                    <StackPanel>
                      <TextBlock Classes="muted">
                        <Run Text="offset " /><Run Text="{Binding Offset}" /><Run Text=" · key " /><Run Text="{Binding Key}" />
                      </TextBlock>
                      <TextBlock Text="{Binding Value}" Foreground="White" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>

</UserControl>
