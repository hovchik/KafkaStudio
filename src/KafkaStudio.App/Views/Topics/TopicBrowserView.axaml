<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KafkaStudio.App.ViewModels.Topics"
             x:Class="KafkaStudio.App.Views.Topics.TopicBrowserView"
             x:DataType="vm:TopicBrowserViewModel">

  <Grid RowDefinitions="Auto,Auto,*" Margin="0">
    <TextBlock Grid.Row="0" Text="Topics" Classes="h1" Foreground="White" Margin="0,0,0,16" />

    <Border Grid.Row="1" Classes="card" Margin="0,0,0,16">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
          <TextBlock Grid.Column="0" Text="Connection" VerticalAlignment="Center" Classes="muted" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding ConnectionNames}" SelectedItem="{Binding SelectedConnection}" HorizontalAlignment="Stretch" />
          <Button Grid.Column="2" Content="Refresh topics" Command="{Binding RefreshTopicsCommand}" />
        </Grid>

        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Grid.Column="0" Text="Filter" VerticalAlignment="Center" Classes="muted" />
          <TextBox Grid.Column="1" Text="{Binding TopicFilter}" Watermark="Filter topics (contains)..." Margin="8,0,0,0" />
        </Grid>

        <Grid ColumnDefinitions="Auto,Auto,Auto,*">
          <TextBlock Grid.Column="0" Text="Selected topic" VerticalAlignment="Center" Classes="muted" />
          <TextBlock Grid.Column="1" Text="{Binding SelectedTopic, TargetNullValue='(none)'}" VerticalAlignment="Center" Foreground="White" Margin="8,0,16,0" />
          <TextBlock Grid.Column="2" Text="Limit" VerticalAlignment="Center" Classes="muted" />
          <TextBox Grid.Column="3" Text="{Binding ScanLimit}" Width="80" HorizontalAlignment="Left" Watermark="limit" />
        </Grid>
        <Button Content="Reload messages" Classes="primary" Command="{Binding ScanCommand}" HorizontalAlignment="Left" />

        <TextBlock Text="{Binding StatusMessage}" Classes="muted" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="1*,1.4*">
      <Border Grid.Column="0" Classes="card">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Topics" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
          <ScrollViewer>
            <ListBox ItemsSource="{Binding Topics}" SelectedItem="{Binding SelectedTopicRow}" DoubleTapped="OnTopicDoubleTapped">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:TopicRowViewModel">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" Foreground="White" />
                    <TextBlock Classes="muted">
                      <Run Text="{Binding PartitionCount, TargetNullValue='…'}" /><Run Text=" partitions, " /><Run Text="{Binding TotalMessageCount, TargetNullValue='…'}" /><Run Text=" messages" />
                    </TextBlock>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Classes="card">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Messages (newest first)" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding ScannedMessages}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="8" Margin="0,0,0,4" Background="{DynamicResource SidebarBrush}" CornerRadius="6">
                    <StackPanel>
                      <SelectableTextBlock Classes="muted">
                        <Run Text="offset " /><Run Text="{Binding Offset}" /><Run Text=" · key " /><Run Text="{Binding Key}" />
                      </SelectableTextBlock>
                      <SelectableTextBlock Text="{Binding PrettyValue}" Foreground="White" TextWrapping="Wrap" FontFamily="Consolas,monospace" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>

</UserControl>
