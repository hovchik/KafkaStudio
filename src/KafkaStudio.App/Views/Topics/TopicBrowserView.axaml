<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:KafkaStudio.App.ViewModels.Topics"
			 xmlns:topics="using:KafkaStudio.Core.Topics"
			 xmlns:conv="using:KafkaStudio.App.Converters"
			 x:Class="KafkaStudio.App.Views.Topics.TopicBrowserView"
			 x:DataType="vm:TopicBrowserViewModel"
			 x:Name="Root">

  <Grid RowDefinitions="Auto,Auto,*" Margin="0">

	<!-- Header -->
	<StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,0,10">
	  <TextBlock Text="Topics" Classes="h1" Foreground="White" VerticalAlignment="Center" />
	  <TextBlock Text="{Binding StatusMessage}" Classes="muted" VerticalAlignment="Center" Margin="8,4,0,0" />
	</StackPanel>

	<!-- Toolbar -->
	<Border Grid.Row="1" Classes="card" Margin="0,0,0,10">
	  <StackPanel Spacing="8">

		<!-- Connection row -->
		<Grid ColumnDefinitions="Auto,*,Auto">
		  <TextBlock Grid.Column="0" Text="Connection" VerticalAlignment="Center" Classes="muted" Width="90" />
		  <ComboBox Grid.Column="1" ItemsSource="{Binding ConnectionNames}" SelectedItem="{Binding SelectedConnection}" HorizontalAlignment="Stretch" />
		  <Button Grid.Column="2" Content="Refresh topics" Command="{Binding RefreshTopicsCommand}" Margin="8,0,0,0" />
		</Grid>

		<Border Height="1" Background="#33FFFFFF" Margin="0,2" />

		<!-- Topic browsing row -->
		<Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
		  <TextBlock Grid.Column="0" Text="Topic filter" VerticalAlignment="Center" Classes="muted" Width="90" />
		  <TextBox Grid.Column="1" Text="{Binding TopicFilter}" Watermark="Filter topics (contains)..." />
		  <TextBlock Grid.Column="2" Text="Selected" VerticalAlignment="Center" Classes="muted" Margin="16,0,0,0" />
		  <TextBlock Grid.Column="3" Text="{Binding SelectedTopic, TargetNullValue='(none)'}" VerticalAlignment="Center" Foreground="White" Margin="8,0,16,0" FontWeight="SemiBold" />
		  <TextBlock Grid.Column="4" Text="Limit" VerticalAlignment="Center" Classes="muted" />
		  <TextBox Grid.Column="5" Text="{Binding ScanLimit, TargetNullValue=''}" Width="70" HorizontalAlignment="Left" Watermark="all" Margin="8,0,0,0" />
		</Grid>

		<Grid ColumnDefinitions="Auto,*,Auto">
		  <Button Grid.Column="0" Content="Reload messages" Classes="primary" Command="{Binding ScanCommand}" />
		  <TextBox Grid.Column="1" Text="{Binding MessageFilter}" Watermark="Search within loaded messages (contains)..." Margin="12,0,0,0" />
		  <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="muted" Margin="12,0,0,0">
			<Run Text="{Binding MatchedMessageCount}" /><Run Text=" / " /><Run Text="{Binding TotalMessageCount}" /><Run Text=" messages" />
		  </TextBlock>
		</Grid>

		<!-- Saved topic filters: collapsed by default to save vertical space -->
		<Expander Header="Saved topic filters">
		  <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,8,0,0">
			<TextBlock Grid.Column="0" Text="Saved filters" VerticalAlignment="Center" Classes="muted" Width="90" />
			<ComboBox Grid.Column="1" ItemsSource="{Binding SavedTopicFilters}" SelectedItem="{Binding SelectedSavedTopicFilter}" PlaceholderText="Select a saved topic filter..." HorizontalAlignment="Stretch" />
			<Button Grid.Column="2" Content="Save filter" Command="{Binding SaveTopicFilterCommand}" Margin="8,0,0,0" />
			<Button Grid.Column="3" Content="Remove" Command="{Binding RemoveSavedTopicFilterCommand}" Margin="8,0,0,0" />
		  </Grid>
		</Expander>

		<!-- Global (cross-topic) search: collapsed by default, used less often than the basic filter/scan above -->
		<Expander Header="Find anywhere (cross-topic search)">
		  <StackPanel Spacing="8" Margin="0,8,0,0">
			<Grid ColumnDefinitions="Auto,*,Auto,Auto">
			  <TextBlock Grid.Column="0" Text="Find anywhere" VerticalAlignment="Center" Classes="muted" Width="90" />
			  <TextBox Grid.Column="1" Text="{Binding GlobalSearchTerm}" Watermark="Search every loaded topic's messages (contains)..." />
			  <Button Grid.Column="2" Content="Search all topics" Classes="primary" Command="{Binding GlobalSearchCommand}" Margin="8,0,0,0" />
			  <Button Grid.Column="3" Content="Cancel" Command="{Binding CancelGlobalSearchCommand}" Margin="8,0,0,0" IsVisible="{Binding IsGlobalSearching}" />
			</Grid>
			<TextBlock Classes="muted" IsVisible="{Binding IsGlobalSearching}">
			  <Run Text="Scanning topic " /><Run Text="{Binding GlobalSearchTopicsScanned}" /><Run Text=" / " /><Run Text="{Binding GlobalSearchTopicsTotal}" /><Run Text="..." />
			</TextBlock>

			<!-- Saved topic sets row: scope "Search all topics" to a named set of topics captured from a
				 previous search's results instead of every loaded topic. -->
			<Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
			  <TextBlock Grid.Column="0" Text="Topic set" VerticalAlignment="Center" Classes="muted" Width="90" />
			  <ComboBox Grid.Column="1" ItemsSource="{Binding SavedTopicSets}" SelectedItem="{Binding SelectedSavedTopicSet}"
						PlaceholderText="(search every loaded topic)" HorizontalAlignment="Stretch">
				<ComboBox.ItemTemplate>
				  <DataTemplate x:DataType="topics:SavedTopicSet">
					<TextBlock Text="{Binding Name}" />
				  </DataTemplate>
				</ComboBox.ItemTemplate>
			  </ComboBox>
			  <TextBox Grid.Column="2" Text="{Binding NewTopicSetName}" Watermark="New set name..." Width="140" Margin="8,0,0,0" />
			  <Button Grid.Column="3" Content="Save results as set" Command="{Binding SaveSearchResultsAsTopicSetCommand}" Margin="8,0,0,0" />
			  <Button Grid.Column="4" Content="Delete" Command="{Binding DeleteSavedTopicSetCommand}" Margin="8,0,0,0" />
			</Grid>
		  </StackPanel>
		</Expander>

	  </StackPanel>
	</Border>

	<!-- Main content: topics list + messages, plus global search results underneath when present -->
	<Grid Grid.Row="2">
	  <Grid.RowDefinitions>
		<RowDefinition Height="{Binding AreTopicsAndMessagesCollapsed, Converter={x:Static conv:BoolToRowHeightConverter.Instance}, ConverterParameter=TopicsAndMessages}" />
		<RowDefinition Height="{Binding AreTopicsAndMessagesCollapsed, Converter={x:Static conv:BoolToRowHeightConverter.Instance}, ConverterParameter=SearchResults}" />
	  </Grid.RowDefinitions>
	  <Grid Grid.Row="0" ColumnDefinitions="1*,1.5*" Margin="0,0,0,10" IsVisible="{Binding !IsGlobalSearchActive}">
		<Border Classes="card" Margin="3,0" Grid.Column="{Binding ArePanelsSwapped, Converter={x:Static conv:SwapColumnConverter.Instance}, ConverterParameter=0}"
				VerticalAlignment="{Binding IsTopicsPanelExpanded, Converter={x:Static conv:BoolToVerticalAlignmentConverter.Instance}}">
		  <DockPanel>
			<Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,6">
			  <TextBlock Grid.Column="0" Text="Topics" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
			  <ProgressBar Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding IsLoadingTopics}" Width="16" Height="16" Margin="0,0,8,0" />
			  <Button Grid.Column="2" Content="⇄" ToolTip.Tip="Swap Topics/Messages panels" Command="{Binding SwapPanelsCommand}" Padding="6,2" Margin="0,0,4,0" />
			  <Button Grid.Column="3" Content="{Binding IsTopicsPanelExpanded, Converter={x:Static conv:BoolToChevronConverter.Instance}}" ToolTip.Tip="Collapse/expand" Command="{Binding ToggleTopicsPanelCommand}" Padding="6,2" />
			</Grid>
			<ScrollViewer IsVisible="{Binding IsTopicsPanelExpanded}">
			  <ListBox ItemsSource="{Binding Topics}" SelectedItem="{Binding SelectedTopicRow}" DoubleTapped="OnTopicDoubleTapped">
				<ListBox.ItemTemplate>
				  <DataTemplate x:DataType="vm:TopicRowViewModel">
					<StackPanel Margin="2,3">
					  <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Medium" />
					  <TextBlock Classes="muted">
						<Run Text="{Binding PartitionCount, TargetNullValue='…'}" /><Run Text=" partitions, " /><Run Text="{Binding TotalMessageCount, TargetNullValue='…'}" /><Run Text=" messages" />
					  </TextBlock>
					</StackPanel>
				  </DataTemplate>
				</ListBox.ItemTemplate>
			  </ListBox>
			</ScrollViewer>
		  </DockPanel>
		</Border>

		<Border Classes="card" Margin="3,0" Grid.Column="{Binding ArePanelsSwapped, Converter={x:Static conv:SwapColumnConverter.Instance}, ConverterParameter=1}"
				VerticalAlignment="{Binding IsMessagesPanelExpanded, Converter={x:Static conv:BoolToVerticalAlignmentConverter.Instance}}">
		  <DockPanel>
			<Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6">
			  <TextBlock Grid.Column="0" Text="Messages (newest first)" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
			  <ProgressBar Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding IsLoadingMessages}" Width="16" Height="16" Margin="0,0,8,0" />
			  <Button Grid.Column="2" Content="{Binding IsMessagesPanelExpanded, Converter={x:Static conv:BoolToChevronConverter.Instance}}" ToolTip.Tip="Collapse/expand" Command="{Binding ToggleMessagesPanelCommand}" Padding="6,2" />
			</Grid>
			<ScrollViewer IsVisible="{Binding IsMessagesPanelExpanded}">
			  <ItemsControl ItemsSource="{Binding ScannedMessages}">
				<ItemsControl.ItemTemplate>
				  <DataTemplate>
					<Border Padding="8" Margin="0,0,0,5" Background="{DynamicResource SidebarBrush}" CornerRadius="8">
					  <StackPanel Spacing="3">
						<SelectableTextBlock Classes="muted">
						  <Run Text="offset " /><Run Text="{Binding Offset}" /><Run Text=" · partition " /><Run Text="{Binding Partition}" /><Run Text=" · key " /><Run Text="{Binding Key}" />
						</SelectableTextBlock>
						<SelectableTextBlock Inlines="{Binding PrettyValue, Converter={x:Static conv:JsonInlinesConverter.Instance}}" Foreground="White" TextWrapping="Wrap" FontFamily="Consolas,monospace" FontSize="12" />
					  </StackPanel>
					</Border>
				  </DataTemplate>
				</ItemsControl.ItemTemplate>
			  </ItemsControl>
			</ScrollViewer>
		  </DockPanel>
		</Border>
	  </Grid>

	  <!-- Cross-topic search results -->
	  <Border Grid.Row="1" Classes="card" IsVisible="{Binding GlobalSearchResults.Count}"
			  MaxHeight="{Binding AreTopicsAndMessagesCollapsed, Converter={x:Static conv:BoolToMaxHeightConverter.Instance}}">
		<DockPanel>
		  <StackPanel DockPanel.Dock="Top" Spacing="5" Margin="0,0,0,6">
			<Grid ColumnDefinitions="*,Auto">
			  <TextBlock Grid.Column="0" VerticalAlignment="Center">
				<Run Text="Search results (all topics)" FontWeight="SemiBold" Foreground="White" /><Run Text=" — " Foreground="{DynamicResource MutedTextBrush}" /><Run Text="{Binding GlobalSearchResults.Count}" FontWeight="SemiBold" Foreground="White" /><Run Text=" total" Foreground="{DynamicResource MutedTextBrush}" />
			  </TextBlock>
			  <Button Grid.Column="1" Content="{Binding IsSearchResultsPanelExpanded, Converter={x:Static conv:BoolToChevronConverter.Instance}}" ToolTip.Tip="Collapse/expand" Command="{Binding ToggleSearchResultsPanelCommand}" Padding="6,2" />
			</Grid>
			<ItemsControl ItemsSource="{Binding GlobalSearchResultsByTopic}" IsVisible="{Binding GlobalSearchResultsByTopic.Count}">
			  <ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
				  <WrapPanel Orientation="Horizontal" />
				</ItemsPanelTemplate>
			  </ItemsControl.ItemsPanel>
			  <ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="vm:TopicHitCount">
				  <Border Classes="chip" Margin="0,0,6,4"
						  Cursor="Hand" ToolTip.Tip="Click to filter results to this topic — click again to clear"
						  Tapped="OnTopicHitCountTapped" Classes.selected="{Binding IsSelected}">
					<TextBlock FontSize="11">
					  <Run Text="{Binding Topic}" Foreground="{DynamicResource AccentBrush}" /><Run Text=" · " Foreground="{DynamicResource MutedTextBrush}" /><Run Text="{Binding Count}" FontWeight="SemiBold" Foreground="White" />
					</TextBlock>
				  </Border>
				</DataTemplate>
			  </ItemsControl.ItemTemplate>
			</ItemsControl>
		  </StackPanel>
		  <ScrollViewer IsVisible="{Binding IsSearchResultsPanelExpanded}">
					<ItemsControl ItemsSource="{Binding FilteredGlobalSearchResults}">
					  <ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:GlobalSearchHit">
						  <Border Padding="8" Margin="0,0,0,5" Background="{DynamicResource SidebarBrush}" CornerRadius="8"
								  DoubleTapped="OnGlobalSearchHitDoubleTapped">
							<StackPanel Spacing="3">
							  <Grid ColumnDefinitions="*,Auto">
								<SelectableTextBlock Grid.Column="0" Classes="muted">
								  <Run Text="topic " FontWeight="SemiBold" /><Run Text="{Binding Topic}" Foreground="{DynamicResource AccentBrush}" /><Run Text=" · offset " /><Run Text="{Binding Message.Offset}" /><Run Text=" · key " /><Run Text="{Binding Message.Key}" />
								</SelectableTextBlock>
								<Button Grid.Column="1" Content="Compare" Padding="6,2"
										Command="{Binding #Root.DataContext.AddToComparisonCommand}"
										CommandParameter="{Binding}" />
							  </Grid>
							  <SelectableTextBlock Inlines="{Binding Message.PrettyValue, Converter={x:Static conv:JsonInlinesConverter.Instance}}" Foreground="White" TextWrapping="Wrap" FontFamily="Consolas,monospace" FontSize="12" />
							</StackPanel>
						  </Border>
						</DataTemplate>
					  </ItemsControl.ItemTemplate>
					</ItemsControl>
				  </ScrollViewer>
				</DockPanel>
				</Border>
			  </Grid>

			  <!-- Compare messages: pinned messages from search results, shown side by side for comparison. -->
			  <Border Classes="card" Margin="0,16,0,0" IsVisible="{Binding ComparisonMessages.Count}">
				<DockPanel>
				  <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
					<TextBlock Grid.Column="0" Text="Compare messages" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
					<Button Grid.Column="1" Content="Clear all" Command="{Binding ClearComparisonCommand}" Padding="6,2" />
				  </Grid>
				  <ScrollViewer>
					<ItemsControl ItemsSource="{Binding ComparisonMessages}">
					  <ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
						  <WrapPanel Orientation="Horizontal" />
						</ItemsPanelTemplate>
					  </ItemsControl.ItemsPanel>
					  <ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:ComparisonEntry">
						  <Border Padding="10" Margin="0,0,8,8" Width="320" Background="{DynamicResource SidebarBrush}" CornerRadius="8">
							<StackPanel Spacing="4">
							  <Grid ColumnDefinitions="*,Auto">
								<SelectableTextBlock Grid.Column="0" Classes="muted">
								  <Run Text="topic " FontWeight="SemiBold" /><Run Text="{Binding Topic}" Foreground="{DynamicResource AccentBrush}" /><Run Text=" · offset " /><Run Text="{Binding Message.Offset}" /><Run Text=" · key " /><Run Text="{Binding Message.Key}" />
								</SelectableTextBlock>
								<Button Grid.Column="1" Content="✕" Padding="6,2"
										Command="{Binding #Root.DataContext.RemoveFromComparisonCommand}"
										CommandParameter="{Binding}" />
							  </Grid>
							  <SelectableTextBlock Inlines="{Binding Message.PrettyValue, Converter={x:Static conv:JsonInlinesConverter.Instance}}" Foreground="White" TextWrapping="Wrap" FontFamily="Consolas,monospace" FontSize="12" />
							</StackPanel>
						  </Border>
						</DataTemplate>
					  </ItemsControl.ItemTemplate>
					</ItemsControl>
				  </ScrollViewer>
				</DockPanel>
			  </Border>
			</Grid>

</UserControl>
