<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:KafkaStudio.App.ViewModels.Producer"
			 x:Class="KafkaStudio.App.Views.Producer.ProducerView"
			 x:DataType="vm:ProducerViewModel">

  <Grid RowDefinitions="Auto,Auto,*">

	<!-- Single-line toolbar: destination + send. -->
	<Border Grid.Row="0" Classes="toolbar">
	  <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,Auto,*">
		<ComboBox Grid.Column="0" Width="170" ItemsSource="{Binding ConnectionNames}"
				  SelectedItem="{Binding SelectedConnection}" ToolTip.Tip="Connection" />
		<AutoCompleteBox Grid.Column="1" MinWidth="160" ItemsSource="{Binding TopicNames}" Text="{Binding Topic}"
						 FilterMode="Contains" Watermark="topic" />

		<Border Grid.Column="2" Classes="sep" />

		<TextBox Grid.Column="3" MinWidth="120" Text="{Binding Key}" Watermark="key (optional)" />
		<Button Grid.Column="4" Content="Send" Classes="primary" Command="{Binding SendCommand}" />
		<Button Grid.Column="5" Content="Add header" Command="{Binding AddHeaderCommand}" />
		<TextBlock Grid.Column="6" Classes="muted" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
	  </Grid>
	</Border>

	<!-- Headers only take space when there are any. -->
	<Border Grid.Row="1" Classes="toolbar" Margin="0,6,0,0" IsVisible="{Binding Headers.Count}">
	  <ItemsControl Name="HeadersList" ItemsSource="{Binding Headers}">
		<ItemsControl.ItemTemplate>
		  <DataTemplate x:DataType="vm:HeaderEntryViewModel">
			<Grid ColumnDefinitions="*,*,Auto" Margin="0,0,0,2">
			  <TextBox Grid.Column="0" Text="{Binding Name}" Watermark="header name" />
			  <TextBox Grid.Column="1" Text="{Binding Value}" Watermark="header value" />
			  <Button Grid.Column="2" Content="✕" Command="{Binding #HeadersList.DataContext.RemoveHeaderCommand}" CommandParameter="{Binding}" />
			</Grid>
		  </DataTemplate>
		</ItemsControl.ItemTemplate>
	  </ItemsControl>
	</Border>

	<!-- Data area: value editor + recently sent, resizable. -->
	<Grid Grid.Row="2" Margin="0,6,0,0" ColumnDefinitions="*,6,320">
	  <Border Grid.Column="0" Classes="pane">
		<DockPanel>
		  <TextBlock DockPanel.Dock="Top" Classes="paneTitle" Text="Value" Margin="0,0,0,6" />
		  <TextBox Text="{Binding Value}" AcceptsReturn="True" TextWrapping="Wrap"
				   FontFamily="Consolas,monospace" FontSize="13"
				   Background="{DynamicResource SidebarBrush}" BorderThickness="0" Padding="10"
				   Watermark="{}{ &quot;example&quot;: true }" />
		</DockPanel>
	  </Border>

	  <GridSplitter Grid.Column="1" ResizeDirection="Columns" Width="6" />

	  <Border Grid.Column="2" Classes="pane">
		<DockPanel>
		  <TextBlock DockPanel.Dock="Top" Classes="paneTitle" Text="Recently sent" Margin="0,0,0,6" />
		  <ScrollViewer>
			<ItemsControl ItemsSource="{Binding History}">
			  <ItemsControl.ItemTemplate>
				<DataTemplate>
				  <Border Classes="row">
					<SelectableTextBlock Text="{Binding}" Classes="muted" TextWrapping="Wrap" />
				  </Border>
				</DataTemplate>
			  </ItemsControl.ItemTemplate>
			</ItemsControl>
		  </ScrollViewer>
		</DockPanel>
	  </Border>
	</Grid>
  </Grid>
</UserControl>
