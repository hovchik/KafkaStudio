<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KafkaStudio.App.ViewModels.Producer"
             xmlns:b="using:KafkaStudio.App.Behaviors"
             x:Class="KafkaStudio.App.Views.Producer.ProducerView"
             x:DataType="vm:ProducerViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendCommand}" />
  </UserControl.KeyBindings>

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- Destination + send. -->
    <Border Grid.Row="0" Classes="toolbar">
      <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
        <ComboBox Grid.Column="0" Width="170" PlaceholderText="Connection…" ItemsSource="{Binding ConnectionNames}"
                  SelectedItem="{Binding SelectedConnection}" ToolTip.Tip="Connection" />
        <AutoCompleteBox Grid.Column="1" MinWidth="160" ItemsSource="{Binding TopicNames}" Text="{Binding Topic}"
                         FilterMode="Contains" Watermark="topic" />

        <Border Grid.Column="2" Classes="sep" />

        <TextBox Grid.Column="3" MinWidth="120" Text="{Binding Key}" Watermark="key (optional, e.g. {{$uuid}})" />
        <TextBox Grid.Column="4" Width="80" Text="{Binding Partition}" Watermark="partition" b:NumericInput.IsEnabled="True"
                 ToolTip.Tip="Optional explicit partition (empty = let the partitioner decide)" />
        <TextBlock Grid.Column="5" Text="×" Classes="muted" />
        <NumericUpDown Grid.Column="6" Width="110" Value="{Binding RepeatCount}" Minimum="1" Maximum="100000" FormatString="0"
                       ToolTip.Tip="Send this many messages - templates like {{$uuid}} are evaluated fresh for each" />
        <CheckBox Grid.Column="7" Content="Tombstone" IsChecked="{Binding IsTombstone}"
                  ToolTip.Tip="Send a null value (deletes the key on compacted topics)" />
        <Button Grid.Column="8" Content="Send" Classes="primary" Command="{Binding SendCommand}" ToolTip.Tip="Send (Ctrl+Enter)" />
        <Button Grid.Column="9" Classes="ghost" Content="Cancel" Command="{Binding CancelSendCommand}" IsVisible="{Binding IsSending}" />
        <Button Grid.Column="10" Content="+ Header" Command="{Binding AddHeaderCommand}" />
        <ProgressBar Grid.Column="11" Classes="busy" IsVisible="{Binding IsSending}" />
      </Grid>
    </Border>

    <!-- Headers only take space when there are any. -->
    <Border Grid.Row="1" Classes="toolbar" Margin="0,6,0,0" IsVisible="{Binding Headers.Count}">
      <ItemsControl Name="HeadersList" ItemsSource="{Binding Headers}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:HeaderEntryViewModel">
            <Grid ColumnDefinitions="*,*,Auto" Margin="0,0,0,2">
              <TextBox Grid.Column="0" Text="{Binding Name}" Watermark="header name" />
              <TextBox Grid.Column="1" Text="{Binding Value}" Watermark="header value (templates allowed)" />
              <Button Grid.Column="2" Classes="icon ghost" ToolTip.Tip="Remove header" Margin="0"
                      Command="{Binding #HeadersList.DataContext.RemoveHeaderCommand}" CommandParameter="{Binding}">
                <PathIcon Data="{StaticResource Icon.close}" />
              </Button>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- Value editor + recently sent, resizable. -->
    <Grid Grid.Row="2" Margin="0,8,0,0" ColumnDefinitions="*,8,340">
      <Border Grid.Column="0" Classes="pane">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Classes="paneTitle" Text="Value" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding ValueInfo}" />
            <Button Grid.Column="2" Classes="small" Content="Format JSON" Command="{Binding FormatJsonCommand}" />
          </Grid>
          <TextBlock DockPanel.Dock="Bottom" Classes="hint" Margin="0,6,0,0">
            <Run Text="Templates: " /><Run Text="{}{{$uuid}}  {{$now}}  {{$timestamp}}  {{$date}}  {{$random}}" FontFamily="{DynamicResource MonoFont}" /><Run Text="  - evaluated per message." />
          </TextBlock>
          <TextBox Classes="code" Text="{Binding Value}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                   IsEnabled="{Binding !IsTombstone}"
                   Watermark="{}{ &quot;example&quot;: true }" />
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Width="8" />

      <Border Grid.Column="2" Classes="pane">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Classes="paneTitle" Text="Recently sent" />
            <Button Grid.Column="1" Classes="small ghost" Content="Clear" Command="{Binding ClearHistoryCommand}" />
          </Grid>
          <Panel>
            <StackPanel Classes="emptyState" IsVisible="{Binding !History.Count}">
              <PathIcon Data="{StaticResource Icon.producer}" />
              <TextBlock Classes="emptyTitle" Text="Nothing sent yet" />
              <TextBlock Classes="emptyHint" Text="Messages you send appear here with their partition and offset." />
            </StackPanel>
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding History}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SentMessageRow">
                    <Border Classes="row">
                      <StackPanel Spacing="2">
                        <SelectableTextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap"
                                             Classes.error="{Binding Failed}" />
                        <SelectableTextBlock Text="{Binding Detail}" Classes="muted mono" TextWrapping="Wrap" MaxHeight="60" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Panel>
        </DockPanel>
      </Border>
    </Grid>

    <Border Grid.Row="3" Classes="statusbar">
      <TextBlock Text="{Binding StatusMessage}" ToolTip.Tip="{Binding StatusMessage}" />
    </Border>
  </Grid>
</UserControl>
