<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:KafkaStudio.App.Converters"
             x:Class="KafkaStudio.App.Views.Shared.MessageDetailView"
             x:Name="Detail">

  <!-- Detail pane for one message: metadata, key, headers, pretty-printed value and actions.
       Used by the Topics and Consume screens (Message/Actions are set by the host view). -->
  <Panel>
    <TextBlock Classes="hint" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
               Text="Select a message to see its key, headers and full value."
               IsVisible="{Binding #Detail.Message, Converter={x:Static ObjectConverters.IsNull}}" />

    <DockPanel IsVisible="{Binding #Detail.Message, Converter={x:Static ObjectConverters.IsNotNull}}">

      <!-- Actions -->
      <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
        <Button Classes="small" Content="Copy value" Margin="0,0,4,4"
                Command="{Binding #Detail.Actions.CopyValueCommand}" CommandParameter="{Binding #Detail.Message}" />
        <Button Classes="small" Content="Copy key" Margin="0,0,4,4"
                Command="{Binding #Detail.Actions.CopyKeyCommand}" CommandParameter="{Binding #Detail.Message}" />
        <Button Classes="small" Content="Copy as JSON" Margin="0,0,4,4"
                ToolTip.Tip="Copy the whole message (metadata, key, headers, value) as JSON"
                Command="{Binding #Detail.Actions.CopyAsJsonCommand}" CommandParameter="{Binding #Detail.Message}" />
        <Button Classes="small" Content="Edit in Producer" Margin="0,0,4,4"
                ToolTip.Tip="Open this message in the Produce screen to resend or modify it"
                Command="{Binding #Detail.Actions.EditInProducerCommand}" CommandParameter="{Binding #Detail.Message}" />
        <Button Classes="small" Content="Find similar" Margin="0,0,4,4"
                ToolTip.Tip="Find Data: messages like this one - same key, same field values, near-duplicates or same shape"
                Command="{Binding #Detail.Actions.FindSimilarCommand}" CommandParameter="{Binding #Detail.Message}" />
        <Button Classes="small" Content="Trace key" Margin="0,0,4,4"
                ToolTip.Tip="Find Data: every message carrying this key, across topics, as a timeline"
                Command="{Binding #Detail.Actions.TraceKeyCommand}" CommandParameter="{Binding #Detail.Message}" />
      </WrapPanel>

      <!-- Metadata -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,0,0,6">
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="TOPIC" Margin="0,0,10,2" />
        <SelectableTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding #Detail.Message.Topic}" FontSize="12" Foreground="{DynamicResource AccentBrush}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="POSITION" Margin="0,0,10,2" />
        <SelectableTextBlock Grid.Row="1" Grid.Column="1" FontSize="12" Foreground="White">
          <Run Text="partition " /><Run Text="{Binding #Detail.Message.Partition}" /><Run Text="  ·  offset " /><Run Text="{Binding #Detail.Message.Offset}" />
        </SelectableTextBlock>

        <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="TIME" Margin="0,0,10,2" />
        <SelectableTextBlock Grid.Row="2" Grid.Column="1" FontSize="12" Foreground="White">
          <Run Text="{Binding #Detail.Message.Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss.fff zzz}'}" /><Run Text="  ·  " /><Run Text="{Binding #Detail.Message.ValueSize}" /><Run Text=" bytes" />
        </SelectableTextBlock>

        <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="KEY" Margin="0,0,10,2" />
        <SelectableTextBlock Grid.Row="3" Grid.Column="1" Classes="mono" Foreground="White" TextWrapping="Wrap"
                             Text="{Binding #Detail.Message.Key, TargetNullValue='(no key)'}" />
      </Grid>

      <!-- Headers (only when there are any) -->
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6"
                  IsVisible="{Binding #Detail.Message.Headers.Count, FallbackValue=False}">
        <TextBlock Classes="label" Text="HEADERS" Margin="0,0,0,2" />
        <ItemsControl ItemsSource="{Binding #Detail.Message.Headers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <SelectableTextBlock Classes="mono" TextWrapping="Wrap">
                <Run Text="{Binding Key}" Foreground="{DynamicResource AccentBrush}" /><Run Text=": " Foreground="Gray" /><Run Text="{Binding Value}" Foreground="White" />
              </SelectableTextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <TextBlock DockPanel.Dock="Top" Classes="label" Text="VALUE" Margin="0,0,0,2" />
      <Border Background="{DynamicResource SidebarBrush}" CornerRadius="6" Padding="8">
        <ScrollViewer HorizontalScrollBarVisibility="Auto">
          <SelectableTextBlock Classes="mono" Foreground="White" TextWrapping="Wrap"
                               Inlines="{Binding #Detail.Message.PrettyValue, Converter={x:Static conv:JsonInlinesConverter.Instance}}" />
        </ScrollViewer>
      </Border>
    </DockPanel>
  </Panel>
</UserControl>
