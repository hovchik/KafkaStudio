<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KafkaStudio.App.ViewModels.DataSearch"
             xmlns:search="using:KafkaStudio.Search"
             xmlns:conv="using:KafkaStudio.App.Converters"
             x:Class="KafkaStudio.App.Views.DataSearch.TraceView"
             x:DataType="vm:TraceViewModel"
             x:CompileBindings="True">

  <DockPanel>
    <!-- Sub-toolbar: this view renders inside the Find Data pane. -->
    <Border DockPanel.Dock="Top" Classes="toolbar" Background="{DynamicResource SurfaceRaisedBrush}">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto">
        <TextBox Grid.Column="0" Text="{Binding Id}" FontFamily="{DynamicResource MonoFont}" Watermark="Id to trace, e.g. ORD-1042">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding RunCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <TextBlock Grid.Column="1" Text="in" Classes="muted" />
        <TextBox Grid.Column="2" Width="140" Text="{Binding MatchField}" Watermark="any"
                 ToolTip.Tip="any = key, headers or anywhere in the value · key · $.order.id · header &quot;name&quot;" />
        <CheckBox Grid.Column="3" Content="Match case" IsChecked="{Binding CaseSensitive}" />
        <Button Grid.Column="4" Content="Trace" Classes="primary" Command="{Binding RunCommand}" />
        <Button Grid.Column="5" Classes="ghost" Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" Margin="0" />
      </Grid>
    </Border>

    <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="2,8,0,6">
      <SelectableTextBlock FontSize="12.5" TextWrapping="Wrap" Text="{Binding Status}" />
      <TextBlock Classes="muted" Text="{Binding Progress}" IsVisible="{Binding IsRunning}" />
      <TextBlock Classes="accent" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding PathText}"
                 IsVisible="{Binding PathText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>

    <Border DockPanel.Dock="Top" Classes="tableHeader">
      <Grid ColumnDefinitions="3,150,Auto,80,80,Auto,*">
        <TextBlock Grid.Column="0" Text="" />
        <TextBlock Grid.Column="1" Text="TOPIC" Margin="8,0,8,0" />
        <TextBlock Grid.Column="2" Text="TIME" Margin="0,0,8,0" />
        <TextBlock Grid.Column="3" Text="+PREV" ToolTip.Tip="Time since the previous message" />
        <TextBlock Grid.Column="4" Text="+FIRST" ToolTip.Tip="Time since the first message" />
        <TextBlock Grid.Column="5" Text="POSITION" Margin="0,0,8,0" />
        <TextBlock Grid.Column="6" Text="VALUE" />
      </Grid>
    </Border>

    <Panel>
      <StackPanel Classes="emptyState" IsVisible="{Binding !Hops.Count}">
        <PathIcon Data="{StaticResource Icon.search}" />
        <TextBlock Classes="emptyTitle" Text="Nothing traced yet" />
        <TextBlock Classes="emptyHint" Text="Enter an id and press Trace to follow it across topics." />
      </StackPanel>
      <ListBox Classes="rows" ItemsSource="{Binding Hops}" SelectedItem="{Binding SelectedHop}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="search:TraceHop">
            <Grid ColumnDefinitions="3,150,Auto,80,80,Auto,*">
              <Border Grid.Column="0" Background="{Binding Message.Partition, Converter={x:Static conv:PartitionToBrushConverter.Instance}}" CornerRadius="2" />
              <TextBlock Grid.Column="1" Classes="accent" FontSize="11" Margin="8,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         Text="{Binding Message.Topic}" />
              <TextBlock Grid.Column="2" Classes="muted mono" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"
                         Text="{Binding Message.Timestamp, StringFormat='{}{0:MM-dd HH:mm:ss.fff}'}" />
              <TextBlock Grid.Column="3" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                         Text="{Binding SincePreviousText}" ToolTip.Tip="Time since the previous message" />
              <TextBlock Grid.Column="4" Classes="muted" FontSize="11" VerticalAlignment="Center"
                         Text="{Binding SinceFirstText}" ToolTip.Tip="Time since the first message" />
              <TextBlock Grid.Column="5" Classes="muted mono" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center">
                <Run Text="#" /><Run Text="{Binding Message.Partition}" /><Run Text="@" /><Run Text="{Binding Message.Offset}" />
              </TextBlock>
              <TextBlock Grid.Column="6" Classes="mono" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                         Text="{Binding Message.ValuePreview}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Panel>
  </DockPanel>
</UserControl>
