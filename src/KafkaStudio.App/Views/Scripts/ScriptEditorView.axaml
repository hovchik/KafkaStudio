<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KafkaStudio.App.ViewModels.Scripts"
             xmlns:conv="using:KafkaStudio.App.Converters"
             xmlns:shared="using:KafkaStudio.App.ViewModels.Shared"
             x:Class="KafkaStudio.App.Views.Scripts.ScriptEditorView"
             x:DataType="vm:ScriptEditorViewModel">

  <Grid ColumnDefinitions="1.3*,1*,Auto">

    <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto,Auto">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
        <TextBlock Grid.Column="0" Text="Script (KafScript)" Classes="h1" Foreground="White" />
        <Button Grid.Column="1" Content="Help &amp; examples" Command="{Binding ToggleHelpCommand}" />
      </Grid>

      <Border Grid.Row="1" Classes="card" Padding="0">
        <TextBox Text="{Binding Source}"
                  AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                  FontFamily="Consolas,Menlo,monospace" FontSize="13"
                  Background="Transparent" BorderThickness="0" Padding="12" />
      </Border>

      <TextBlock Grid.Row="2" Text="{Binding ParseError}" Classes="status-failed" TextWrapping="Wrap" Margin="0,8,0,0" />

      <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
        <Button Content="Run all" Classes="primary" Command="{Binding RunAllCommand}" />
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRunning}" Width="16" Height="16" VerticalAlignment="Center" />
        <TextBlock Text="{Binding RunSummary}" VerticalAlignment="Center" Classes="muted" />
      </StackPanel>
    </Grid>

    <Border Grid.Column="1" Classes="card">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Step results" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10" />
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding StepResults}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StepResultRowViewModel">
                <Border Padding="8" Margin="0,0,0,6" Background="{DynamicResource SidebarBrush}" CornerRadius="6">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Keyword}" Classes="muted" />
                      <TextBlock Text="{Binding Description}" Foreground="White" />
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                               Foreground="{Binding Status, Converter={x:Static conv:StepStatusToBrushConverter.Instance}}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Border Grid.Column="2" Classes="card" Width="340" Margin="12,0,0,0" IsVisible="{Binding IsHelpVisible}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="KafScript help &amp; examples" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10" />
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding HelpTopics}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="shared:HelpTopicViewModel" x:CompileBindings="False">
                <Border Padding="8" Margin="0,0,0,8" Background="{DynamicResource SidebarBrush}" CornerRadius="6">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="{Binding Syntax}" FontFamily="Consolas,Menlo,monospace" FontSize="12" TextWrapping="Wrap" Classes="muted" />
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="White" FontSize="12" />
                    <TextBlock Text="{Binding Example}" FontFamily="Consolas,Menlo,monospace" FontSize="11" TextWrapping="Wrap" Classes="muted" />
                    <Button Content="Insert into script" Command="{Binding $parent[ItemsControl].DataContext.InsertExampleCommand}" CommandParameter="{Binding}" HorizontalAlignment="Left" Padding="6,2" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

  </Grid>

</UserControl>
