<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KafkaStudio.App.ViewModels.Scripts"
             xmlns:conv="using:KafkaStudio.App.Converters"
             xmlns:shared="using:KafkaStudio.App.ViewModels.Shared"
             x:Class="KafkaStudio.App.Views.Scripts.ScriptEditorView"
             x:DataType="vm:ScriptEditorViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding RunAllCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding RunAllCommand}" />
    <KeyBinding Gesture="Shift+F5" Command="{Binding StopCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="F1" Command="{Binding ToggleHelpCommand}" />
  </UserControl.KeyBindings>

  <Grid RowDefinitions="Auto,*">

    <Border Grid.Row="0" Classes="toolbar">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
        <Button Grid.Column="0" Content="New" Command="{Binding NewCommand}" />
        <Button Grid.Column="1" Content="Open…" Command="{Binding OpenCommand}" ToolTip.Tip="Open a .kafscript file (Ctrl+O)" />
        <Button Grid.Column="2" Content="Save" Command="{Binding SaveCommand}" ToolTip.Tip="Save (Ctrl+S) · Save as: Ctrl+Shift+S" />
        <Border Grid.Column="3" Classes="sep" />
        <Button Grid.Column="4" Content="▶ Run all" Classes="primary" Command="{Binding RunAllCommand}" ToolTip.Tip="Run every Scenario/Task (Ctrl+Enter or F5)" />
        <Button Grid.Column="5" Content="■ Stop" Command="{Binding StopCommand}" ToolTip.Tip="Stop the run (Shift+F5)" />
        <ProgressBar Grid.Column="6" Classes="busy" IsVisible="{Binding IsRunning}" />
        <Border Grid.Column="7" Classes="sep" />
        <TextBlock Grid.Column="8" Text="{Binding RunSummary}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                   Foreground="{Binding LastRunPassed, Converter={x:Static conv:PassFailBrushConverter.Instance}}" />
        <Button Grid.Column="9" Content="Help &amp; examples" Command="{Binding ToggleHelpCommand}" Margin="0" ToolTip.Tip="F1" />
      </Grid>
    </Border>

    <!-- Editor + results (+ optional help), all resizable. -->
    <Grid Grid.Row="1" Margin="0,8,0,0" ColumnDefinitions="1.4*,8,1*,Auto,Auto">

      <Border Grid.Column="0" Classes="pane">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Classes="paneTitle" Text="{Binding Title}" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding DocumentSummary}" />
          </Grid>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" Spacing="2">
            <TextBlock Classes="error" Text="{Binding ParseError}"
                       IsVisible="{Binding ParseError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="hint" Text="{Binding ConnectionsHint}" />
          </StackPanel>
          <TextBox Classes="code" Text="{Binding Source}"
                   AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" />
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Width="8" />

      <Border Grid.Column="2" Classes="pane">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Classes="paneTitle" Text="Step results" />
            <Button Grid.Column="1" Classes="small ghost" Content="Clear" Command="{Binding ClearResultsCommand}" />
          </Grid>
          <Panel>
            <StackPanel Classes="emptyState" IsVisible="{Binding !StepResults.Count}">
              <PathIcon Data="{StaticResource Icon.scripts}" />
              <TextBlock Classes="emptyTitle" Text="No results yet" />
              <TextBlock Classes="emptyHint" Text="Run the script (Ctrl+Enter) - each step's result streams in here." />
            </StackPanel>
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding StepResults}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StepResultRowViewModel">
                    <Panel>
                      <!-- Block header -->
                      <TextBlock IsVisible="{Binding IsBlockHeader}" Margin="0,8,0,4" FontWeight="SemiBold" FontSize="13">
                        <Run Text="{Binding Keyword}" Foreground="{DynamicResource AccentBrush}" /><Run Text=": " /><Run Text="{Binding Description}" />
                      </TextBlock>
                      <!-- Step -->
                      <Border Classes="row" Padding="8,6" Margin="0,0,0,4" IsVisible="{Binding !IsBlockHeader}">
                        <Grid ColumnDefinitions="18,*,Auto" RowDefinitions="Auto,Auto">
                          <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding StatusGlyph}" FontWeight="Bold"
                                     Foreground="{Binding Status, Converter={x:Static conv:StepStatusToBrushConverter.Instance}}" />
                          <TextBlock Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" FontSize="12">
                            <Run Text="{Binding Line, StringFormat='L{0} '}" Foreground="{DynamicResource TextMutedBrush}" /><Run Text="{Binding Keyword}" Foreground="{DynamicResource TextMutedBrush}" /><Run Text=" " /><Run Text="{Binding Description}" />
                          </TextBlock>
                          <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding DurationText}" Classes="muted" FontSize="11" Margin="6,0,0,0" />
                          <SelectableTextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Message}" TextWrapping="Wrap" FontSize="12"
                                               Margin="0,2,0,0"
                                               Foreground="{Binding Status, Converter={x:Static conv:StepStatusToBrushConverter.Instance}}" />
                        </Grid>
                      </Border>
                    </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Panel>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns" Width="8" IsVisible="{Binding IsHelpVisible}" />

      <Border Grid.Column="4" Classes="pane" Width="340" IsVisible="{Binding IsHelpVisible}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Classes="paneTitle" Text="KafScript help &amp; examples" />
            <Button Grid.Column="1" Classes="icon small ghost" Command="{Binding ToggleHelpCommand}" ToolTip.Tip="Close (F1)">
              <PathIcon Data="{StaticResource Icon.close}" />
            </Button>
          </Grid>
          <ScrollViewer>
            <ItemsControl Name="HelpTopicsList" ItemsSource="{Binding HelpTopics}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="shared:HelpTopicViewModel">
                  <Border Classes="row">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" />
                      <SelectableTextBlock Text="{Binding Syntax}" Classes="mono muted" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" />
                      <SelectableTextBlock Text="{Binding Example}" Classes="mono muted" FontSize="11" TextWrapping="Wrap" />
                      <Button Classes="small" Content="Insert into script" HorizontalAlignment="Left"
                              Command="{Binding #HelpTopicsList.DataContext.InsertExampleCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

    </Grid>
  </Grid>
</UserControl>
