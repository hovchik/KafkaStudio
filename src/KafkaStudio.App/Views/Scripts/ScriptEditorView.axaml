<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:KafkaStudio.App.ViewModels.Scripts"
			 xmlns:conv="using:KafkaStudio.App.Converters"
			 xmlns:shared="using:KafkaStudio.App.ViewModels.Shared"
			 x:Class="KafkaStudio.App.Views.Scripts.ScriptEditorView"
			 x:DataType="vm:ScriptEditorViewModel">

  <Grid RowDefinitions="Auto,*">

	<!-- Single-line toolbar. -->
	<Border Grid.Row="0" Classes="toolbar">
	  <Grid ColumnDefinitions="Auto,Auto,*,Auto">
		<Button Grid.Column="0" Content="Run all" Classes="primary" Command="{Binding RunAllCommand}" />
		<ProgressBar Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding IsRunning}" Width="16" Height="16"
					 VerticalAlignment="Center" Margin="0,0,6,0" />
		<TextBlock Grid.Column="2" Classes="muted" Text="{Binding RunSummary}" TextTrimming="CharacterEllipsis" />
		<Button Grid.Column="3" Content="Help &amp; examples" Command="{Binding ToggleHelpCommand}" Margin="0" />
	  </Grid>
	</Border>

	<!-- Data area: editor + results (+ optional help), all resizable. -->
	<Grid Grid.Row="1" Margin="0,6,0,0" ColumnDefinitions="1.4*,6,1*,Auto,Auto">

	  <Border Grid.Column="0" Classes="pane">
		<DockPanel>
		  <TextBlock DockPanel.Dock="Top" Classes="paneTitle" Text="Script (KafScript)" Margin="0,0,0,6" />
		  <TextBlock DockPanel.Dock="Bottom" Text="{Binding ParseError}" Classes="status-failed"
					 TextWrapping="Wrap" Margin="0,6,0,0" IsVisible="{Binding ParseError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
		  <TextBox Text="{Binding Source}"
				   AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
				   FontFamily="Consolas,Menlo,monospace" FontSize="13"
				   Background="{DynamicResource SidebarBrush}" BorderThickness="0" Padding="10" />
		</DockPanel>
	  </Border>

	  <GridSplitter Grid.Column="1" ResizeDirection="Columns" Width="6" />

	  <Border Grid.Column="2" Classes="pane">
		<DockPanel>
		  <TextBlock DockPanel.Dock="Top" Classes="paneTitle" Text="Step results" Margin="0,0,0,6" />
		  <ScrollViewer>
			<ItemsControl ItemsSource="{Binding StepResults}">
			  <ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="vm:StepResultRowViewModel">
				  <Border Classes="row">
					<StackPanel Spacing="2">
					  <StackPanel Orientation="Horizontal" Spacing="6">
						<TextBlock Text="{Binding Keyword}" Classes="muted" />
						<TextBlock Text="{Binding Description}" Foreground="White" FontSize="12" />
					  </StackPanel>
					  <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12"
								 Foreground="{Binding Status, Converter={x:Static conv:StepStatusToBrushConverter.Instance}}" />
					</StackPanel>
				  </Border>
				</DataTemplate>
			  </ItemsControl.ItemTemplate>
			</ItemsControl>
		  </ScrollViewer>
		</DockPanel>
	  </Border>

	  <GridSplitter Grid.Column="3" ResizeDirection="Columns" Width="6" IsVisible="{Binding IsHelpVisible}" />

	  <Border Grid.Column="4" Classes="pane" Width="320" IsVisible="{Binding IsHelpVisible}">
		<DockPanel>
		  <TextBlock DockPanel.Dock="Top" Classes="paneTitle" Text="KafScript help &amp; examples" Margin="0,0,0,6" />
		  <ScrollViewer>
			<ItemsControl ItemsSource="{Binding HelpTopics}">
			  <ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="shared:HelpTopicViewModel" x:CompileBindings="False">
				  <Border Classes="row" Padding="8">
					<StackPanel Spacing="3">
					  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White" FontSize="12" />
					  <TextBlock Text="{Binding Syntax}" FontFamily="Consolas,Menlo,monospace" FontSize="12" TextWrapping="Wrap" Classes="muted" />
					  <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="White" FontSize="12" />
					  <TextBlock Text="{Binding Example}" FontFamily="Consolas,Menlo,monospace" FontSize="11" TextWrapping="Wrap" Classes="muted" />
					  <Button Content="Insert into script" Command="{Binding $parent[ItemsControl].DataContext.InsertExampleCommand}" CommandParameter="{Binding}" HorizontalAlignment="Left" Padding="6,2" />
					</StackPanel>
				  </Border>
				</DataTemplate>
			  </ItemsControl.ItemTemplate>
			</ItemsControl>
		  </ScrollViewer>
		</DockPanel>
	  </Border>

	</Grid>
  </Grid>
</UserControl>
