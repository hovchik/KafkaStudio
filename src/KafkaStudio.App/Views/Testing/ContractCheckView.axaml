<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KafkaStudio.App.ViewModels.Testing"
             xmlns:conv="using:KafkaStudio.App.Converters"
             xmlns:shared="using:KafkaStudio.App.Views.Shared"
             x:Class="KafkaStudio.App.Views.Testing.ContractCheckView"
             x:DataType="vm:ContractCheckViewModel"
             x:CompileBindings="True">

  <Grid RowDefinitions="Auto,*">

    <Border Grid.Row="0" Classes="toolbar">
      <WrapPanel>
        <ComboBox Width="160" PlaceholderText="Connection…" ItemsSource="{Binding ConnectionNames}" SelectedItem="{Binding SelectedConnection}" Margin="0,0,6,4" />
        <AutoCompleteBox Width="220" Watermark="topic" ItemsSource="{Binding TopicNames}" Text="{Binding Topic}" FilterMode="Contains"
                         MinimumPrefixLength="0" Margin="0,0,2,4" />
        <Button Content="⟳" ToolTip.Tip="Reload topics" Command="{Binding LoadTopicsCommand}" Margin="0,0,6,4" />
        <Border Classes="sep" Height="20" Margin="2,0,8,4" />
        <CheckBox Content="Newest" IsChecked="{Binding NewestOnly}" Margin="0,0,4,4"
                  ToolTip.Tip="Check only the newest N messages per partition (unchecked: the whole topic, up to 200,000)" />
        <NumericUpDown Width="110" Value="{Binding NewestCount}" Minimum="1" Maximum="200000" Increment="100" FormatString="0"
                       IsEnabled="{Binding NewestOnly}" Margin="0,0,4,4" />
        <TextBlock Classes="muted" Text="per partition" Margin="0,0,8,4" />
        <Border Classes="sep" Height="20" Margin="2,0,8,4" />
        <Button Content="✓ Validate" Classes="primary" Command="{Binding ValidateCommand}" Margin="0,0,6,4" />
        <Button Content="Infer schema" Command="{Binding InferCommand}" Margin="0,0,6,4"
                ToolTip.Tip="Replace the schema with one inferred from the topic's messages, as a starting point" />
        <Button Content="■ Stop" Command="{Binding StopCommand}" Margin="0,0,6,4" />
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="16" Height="16" MinWidth="16" Margin="0,0,6,4" />
        <Button Content="Turn into a check" Command="{Binding ToScriptCommand}" Margin="0,0,0,4"
                ToolTip.Tip="Add a KafScript scenario that validates this topic against this schema to the Script Editor" />
      </WrapPanel>
    </Border>

    <Grid Grid.Row="1" Margin="0,6,0,0" ColumnDefinitions="0.9*,6,1.1*,6,1*">

      <!-- Schema -->
      <Border Grid.Column="0" Classes="pane">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6">
            <TextBlock Grid.Column="0" Classes="paneTitle" Text="Contract (JSON Schema)" />
            <Button Grid.Column="1" Classes="small" Content="Open…" Command="{Binding OpenSchemaCommand}" Margin="0,0,4,0" />
            <Button Grid.Column="2" Classes="small" Content="Save…" Command="{Binding SaveSchemaCommand}" />
          </Grid>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" Spacing="2">
            <TextBlock Classes="error" Text="{Binding SchemaError}"
                       IsVisible="{Binding SchemaError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="hint" TextWrapping="Wrap"
                       Text="type · properties · required · additionalProperties · enum · const · minimum/maximum · pattern · format (date-time, uuid, email…) · items · anyOf/oneOf · $ref" />
          </StackPanel>
          <TextBox Text="{Binding SchemaText}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                   FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="12"
                   Background="{DynamicResource SidebarBrush}" BorderThickness="0" Padding="10" />
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Width="6" />

      <!-- Results -->
      <Border Grid.Column="2" Classes="pane">
        <Grid RowDefinitions="Auto,Auto,*">
          <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Classes="paneTitle" Text="Results" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Border Classes="badge"><TextBlock Text="{Binding CheckedCount, StringFormat='{}{0:N0} checked'}" /></Border>
                <Border Classes="badge ok"><TextBlock Text="{Binding ValidCount, StringFormat='{}{0:N0} valid'}" /></Border>
                <Border Classes="badge bad"><TextBlock Text="{Binding InvalidCount, StringFormat='{}{0:N0} invalid'}" /></Border>
              </StackPanel>
            </Grid>
            <SelectableTextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontWeight="SemiBold"
                                 Foreground="{Binding LastPassed, Converter={x:Static conv:PassFailBrushConverter.Instance}}" />
          </StackPanel>

          <StackPanel Grid.Row="1" Spacing="2" Margin="0,0,0,8" IsVisible="{Binding ProblemGroups.Count}">
            <TextBlock Classes="label" Text="MOST COMMON PROBLEMS" />
            <ItemsControl ItemsSource="{Binding ProblemGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ContractProblemGroup">
                  <Grid ColumnDefinitions="56,*">
                    <TextBlock Grid.Column="0" Text="{Binding CountText}" FontWeight="Bold" Foreground="{DynamicResource FailureBrush}" FontSize="12" />
                    <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap">
                      <Run Text="{Binding Path}" Foreground="White" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Example}" Foreground="{DynamicResource MutedTextBrush}" />
                    </TextBlock>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Panel Grid.Row="2">
            <TextBlock Classes="hint" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="340"
                       Text="Pick a topic, paste or infer its contract, then Validate. Messages that break it are listed here."
                       IsVisible="{Binding !Violations.Count}" />
            <ListBox Classes="rows" ItemsSource="{Binding Violations}" SelectedItem="{Binding SelectedViolation}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ContractViolationRowViewModel">
                  <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Margin="0,2">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Location}" Classes="mono" Foreground="White" FontSize="11" Margin="0,0,8,0" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Key}" Classes="mono muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Timestamp}" Classes="muted" FontSize="11" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                      <Run Text="{Binding FirstProblem}" Foreground="{DynamicResource FailureBrush}" /><Run Text="  " /><Run Text="{Binding CountText}" Foreground="{DynamicResource MutedTextBrush}" />
                    </TextBlock>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Panel>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns" Width="6" />

      <!-- Selected message -->
      <Border Grid.Column="4" Classes="pane">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="paneTitle" Text="Message" Margin="0,0,0,6" />
          <SelectableTextBlock DockPanel.Dock="Top" Text="{Binding SelectedViolation.AllProblems, FallbackValue=''}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource FailureBrush}" Margin="0,0,0,8" />
          <shared:MessageDetailView Message="{Binding SelectedMessage}" Actions="{Binding Actions}" />
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
