<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KafkaStudio.App.ViewModels.Testing"
             x:Class="KafkaStudio.App.Views.Testing.QaLabView"
             x:DataType="vm:QaLabViewModel"
             x:CompileBindings="True">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="F1" Command="{Binding Help.ToggleCommand}" />
  </UserControl.KeyBindings>

  <Grid ColumnDefinitions="*,Auto,Auto">
    <TabControl Grid.Column="0" SelectedIndex="{Binding SelectedTabIndex}">
      <TabItem Header="Test Runner" ToolTip.Tip="Run .kafscript regression packs by tag, with retries and shareable reports">
        <ContentControl Content="{Binding Tests}" />
      </TabItem>
      <TabItem Header="Contract check" ToolTip.Tip="Validate a topic's messages against a JSON Schema, or infer one">
        <ContentControl Content="{Binding Contracts}" />
      </TabItem>
    </TabControl>

    <!-- Sits on the tab strip's free right-hand side. -->
    <Button Grid.Column="0" Classes="ghost" Content="Help &amp; examples" Command="{Binding Help.ToggleCommand}"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,0,0"
            ToolTip.Tip="How-tos for the Test Runner and Contract check (F1)" />

    <GridSplitter Grid.Column="1" ResizeDirection="Columns" Width="8" IsVisible="{Binding Help.IsVisible}" />

    <Border Grid.Column="2" Classes="pane" Width="360" IsVisible="{Binding Help.IsVisible}">
      <ContentControl Content="{Binding Help}" />
    </Border>
  </Grid>
</UserControl>
