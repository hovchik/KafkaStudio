<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:KafkaStudio.App.ViewModels.Consumer"
			 xmlns:conv="using:KafkaStudio.App.Converters"
			 x:Class="KafkaStudio.App.Views.Consumer.ConsumerView"
			 x:DataType="vm:ConsumerViewModel">

  <Grid RowDefinitions="Auto,*">

	<!-- Single-line toolbar: everything needed to start/stop a live consume. -->
	<Border Grid.Row="0" Classes="toolbar">
	  <Grid ColumnDefinitions="180,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
		<ComboBox Grid.Column="0" Width="170" HorizontalAlignment="Left" ItemsSource="{Binding ConnectionNames}"
				  SelectedItem="{Binding SelectedConnection}" ToolTip.Tip="Connection" />
		<AutoCompleteBox Grid.Column="1" MinWidth="160" ItemsSource="{Binding TopicNames}" Text="{Binding Topic}"
						 FilterMode="Contains" Watermark="topic name" />

		<Border Grid.Column="2" Classes="sep" />

		<CheckBox Grid.Column="3" Content="From beginning" IsChecked="{Binding FromBeginning}" />
		<TextBlock Grid.Column="4" Text="Limit" Classes="muted" />
		<NumericUpDown Grid.Column="5" Value="{Binding MessageLimit}" Minimum="0" Maximum="10000" Increment="1"
					   Width="110" ToolTip.Tip="Maximum number of most-recent messages to keep (0 = unlimited)" />
		<Button Grid.Column="6" Content="Start" Classes="primary" Command="{Binding StartCommand}" />
		<Button Grid.Column="7" Content="Stop" Command="{Binding StopCommand}" />
		<Button Grid.Column="8" Content="Clear" Command="{Binding ClearCommand}" />

		<ProgressBar Grid.Column="9" IsIndeterminate="True" IsVisible="{Binding IsWatching}" Width="16" Height="16"
					 VerticalAlignment="Center" Margin="0,0,6,0" />
		<TextBlock Grid.Column="10" Classes="muted" MaxWidth="220" TextTrimming="CharacterEllipsis"
				   ToolTip.Tip="{Binding StatusMessage}">
		  <Run Text="{Binding Messages.Count}" /><Run Text=" shown · " /><Run Text="{Binding StatusMessage}" />
		</TextBlock>
	  </Grid>
	</Border>

	<!-- Data area fills everything else. -->
	<Border Grid.Row="1" Classes="pane" Margin="0,6,0,0">
	  <ScrollViewer>
		<ItemsControl ItemsSource="{Binding Messages}">
		  <ItemsControl.ItemTemplate>
			<DataTemplate>
			  <Border Classes="row" Padding="0">
				<Grid ColumnDefinitions="4,*">
				  <Border Grid.Column="0" Background="{Binding Partition, Converter={x:Static conv:PartitionToBrushConverter.Instance}}" CornerRadius="3,0,0,3" />
				  <StackPanel Grid.Column="1" Spacing="3" Margin="10,6,8,6">
					<Grid ColumnDefinitions="*,Auto">
					  <WrapPanel Grid.Column="0" Orientation="Horizontal">
						<Border Background="{Binding Partition, Converter={x:Static conv:PartitionToBrushConverter.Instance}}" CornerRadius="4" Padding="6,1" Margin="0,0,6,0">
						  <TextBlock Text="{Binding Topic}" FontWeight="SemiBold" FontSize="11" Foreground="Black" />
						</Border>
						<TextBlock Text="{Binding Partition, StringFormat='partition {0}'}" Classes="muted" VerticalAlignment="Center" Margin="0,0,6,0" />
						<TextBlock Text="{Binding Offset, StringFormat='offset {0}'}" Classes="muted" VerticalAlignment="Center" Margin="0,0,6,0" />
						<TextBlock Text="{Binding Key, TargetNullValue='(no key)'}" Classes="muted" VerticalAlignment="Center" FontStyle="Italic" />
					  </WrapPanel>
					  <TextBlock Grid.Column="1" Text="{Binding Timestamp, StringFormat='HH:mm:ss.fff'}" Classes="muted" VerticalAlignment="Center" />
					</Grid>
					<SelectableTextBlock Inlines="{Binding PrettyValue, Converter={x:Static conv:JsonInlinesConverter.Instance}}" Foreground="White" TextWrapping="Wrap" FontFamily="Consolas,monospace" FontSize="12" />
				  </StackPanel>
				</Grid>
			  </Border>
			</DataTemplate>
		  </ItemsControl.ItemTemplate>
		</ItemsControl>
	  </ScrollViewer>
	</Border>
  </Grid>
</UserControl>
