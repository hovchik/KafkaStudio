<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:KafkaStudio.App.ViewModels.Tasks"
			 xmlns:shared="using:KafkaStudio.App.ViewModels.Shared"
			 x:Class="KafkaStudio.App.Views.Tasks.TasksView"
			 x:DataType="vm:TasksViewModel">

  <Grid RowDefinitions="Auto,*">

	<!-- Single-line toolbar. -->
	<Border Grid.Row="0" Classes="toolbar">
	  <Grid ColumnDefinitions="Auto,*,Auto">
		<Button Grid.Column="0" Content="Register" Classes="primary" Command="{Binding RegisterTaskCommand}" />
		<TextBlock Grid.Column="1" Classes="muted" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
		<Button Grid.Column="2" Content="Help &amp; examples" Command="{Binding ToggleHelpCommand}" Margin="0" />
	  </Grid>
	</Border>

	<!-- Data area: new task editor + scheduled tasks (+ optional help), all resizable. -->
	<Grid Grid.Row="1" Margin="0,6,0,0" ColumnDefinitions="1*,6,1.2*,Auto,Auto">

	  <Border Grid.Column="0" Classes="pane">
		<DockPanel>
		  <TextBlock DockPanel.Dock="Top" Classes="paneTitle" Text="Register a task" Margin="0,0,0,6" />
		  <TextBox Text="{Binding NewTaskSource}"
				   AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
				   FontFamily="Consolas,Menlo,monospace" FontSize="13"
				   Background="{DynamicResource SidebarBrush}" BorderThickness="0" Padding="10" />
		</DockPanel>
	  </Border>

	  <GridSplitter Grid.Column="1" ResizeDirection="Columns" Width="6" />

	  <Border Grid.Column="2" Classes="pane">
		<DockPanel>
		  <TextBlock DockPanel.Dock="Top" Classes="paneTitle" Margin="0,0,0,6">
			<Run Text="Scheduled tasks &amp; checks" /><Run Text=" " /><Run Text="{Binding Jobs.Count}" Foreground="{DynamicResource MutedTextBrush}" />
		  </TextBlock>
		  <ScrollViewer>
			<ItemsControl Name="JobsList" ItemsSource="{Binding Jobs}">
			  <ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="vm:TaskRowViewModel">
				  <Border Classes="row">
					<Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
					  <StackPanel Grid.Row="0" Grid.Column="0" Spacing="1">
						<TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White" FontSize="12" />
						<TextBlock Text="{Binding Schedule}" Classes="muted" />
					  </StackPanel>
					  <Button Grid.Row="0" Grid.Column="1" Content="Run now" Padding="8,2" Margin="0,0,6,0"
							  Command="{Binding #JobsList.DataContext.RunNowCommand}" CommandParameter="{Binding}" />
					  <Button Grid.Row="0" Grid.Column="2" Content="Remove" Padding="8,2"
							  Command="{Binding #JobsList.DataContext.RemoveCommand}" CommandParameter="{Binding}" />
					  <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding LastResult}"
								 Classes="muted" Margin="0,6,0,0" TextWrapping="Wrap" />
					</Grid>
				  </Border>
				</DataTemplate>
			  </ItemsControl.ItemTemplate>
			</ItemsControl>
		  </ScrollViewer>
		</DockPanel>
	  </Border>

	  <GridSplitter Grid.Column="3" ResizeDirection="Columns" Width="6" IsVisible="{Binding IsHelpVisible}" />

	  <Border Grid.Column="4" Classes="pane" Width="320" IsVisible="{Binding IsHelpVisible}">
		<DockPanel>
		  <TextBlock DockPanel.Dock="Top" Classes="paneTitle" Text="KafScript help &amp; examples" Margin="0,0,0,6" />
		  <ScrollViewer>
			<ItemsControl Name="HelpTopicsList" ItemsSource="{Binding HelpTopics}">
			  <ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="shared:HelpTopicViewModel">
				  <Border Classes="row" Padding="8">
					<StackPanel Spacing="3">
					  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White" FontSize="12" />
					  <TextBlock Text="{Binding Syntax}" FontFamily="Consolas,Menlo,monospace" FontSize="12" TextWrapping="Wrap" Classes="muted" />
					  <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="White" FontSize="12" />
					  <TextBlock Text="{Binding Example}" FontFamily="Consolas,Menlo,monospace" FontSize="11" TextWrapping="Wrap" Classes="muted" />
					  <Button Content="Insert into script" Command="{Binding #HelpTopicsList.DataContext.InsertExampleCommand}" CommandParameter="{Binding}" HorizontalAlignment="Left" Padding="6,2" />
					</StackPanel>
				  </Border>
				</DataTemplate>
			  </ItemsControl.ItemTemplate>
			</ItemsControl>
		  </ScrollViewer>
		</DockPanel>
	  </Border>

	</Grid>
  </Grid>
</UserControl>
