<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KafkaStudio.App.ViewModels.Tasks"
             x:Class="KafkaStudio.App.Views.Tasks.TasksView"
             x:DataType="vm:TasksViewModel">

  <Grid ColumnDefinitions="1*,1.2*" ColumnSpacing="16">

    <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">
      <TextBlock Grid.Row="0" Text="Register a Task" Classes="h1" Foreground="White" Margin="0,0,0,12" />
      <Border Grid.Row="1" Classes="card" Padding="0">
        <TextBox Text="{Binding NewTaskSource}"
                  AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                  FontFamily="Consolas,Menlo,monospace" FontSize="13"
                  Background="Transparent" BorderThickness="0" Padding="12" />
      </Border>
      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
        <Button Content="Register" Classes="primary" Command="{Binding RegisterTaskCommand}" />
        <TextBlock Text="{Binding StatusMessage}" Classes="muted" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <TextBlock Grid.Row="0" Text="Scheduled tasks &amp; checks" Classes="h1" Foreground="White" Margin="0,0,0,12" />
      <ScrollViewer Grid.Row="1">
        <ItemsControl Name="JobsList" ItemsSource="{Binding Jobs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TaskRowViewModel">
              <Border Classes="card" Margin="0,0,0,10">
                <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                  <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="{Binding Schedule}" Classes="muted" />
                  </StackPanel>
                  <Button Grid.Row="0" Grid.Column="1" Content="Run now"
                          Command="{Binding #JobsList.DataContext.RunNowCommand}" CommandParameter="{Binding}" Margin="0,0,8,0" />
                  <Button Grid.Row="0" Grid.Column="2" Content="Remove"
                          Command="{Binding #JobsList.DataContext.RemoveCommand}" CommandParameter="{Binding}" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding LastResult}" Classes="muted" Margin="0,8,0,0" TextWrapping="Wrap" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

  </Grid>

</UserControl>
