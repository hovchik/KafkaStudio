<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KafkaStudio.App.ViewModels.Tasks"
             xmlns:conv="using:KafkaStudio.App.Converters"
             xmlns:shared="using:KafkaStudio.App.ViewModels.Shared"
             x:Class="KafkaStudio.App.Views.Tasks.TasksView"
             x:DataType="vm:TasksViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding RegisterTaskCommand}" />
    <KeyBinding Gesture="F1" Command="{Binding ToggleHelpCommand}" />
  </UserControl.KeyBindings>

  <Grid RowDefinitions="Auto,*">

    <Border Grid.Row="0" Classes="toolbar">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Grid.Column="0" Content="Register" Classes="primary" Command="{Binding RegisterTaskCommand}"
                ToolTip.Tip="Register (or update, by name) the task(s) in the editor (Ctrl+Enter)" />
        <!-- Status lives in the toolbar on this screen: the panes below need the whole height. -->
        <TextBlock Grid.Column="1" Classes="muted" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusMessage}" />
        <Button Grid.Column="2" Content="Help &amp; examples" Command="{Binding ToggleHelpCommand}" Margin="0" ToolTip.Tip="F1" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="0,8,0,0" ColumnDefinitions="1*,8,1.3*,Auto,Auto">

      <Border Grid.Column="0" Classes="pane">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="paneTitle" Text="Task source" Margin="0,0,0,8" />
          <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" Spacing="2">
            <TextBlock Classes="error" Text="{Binding ParseError}"
                       IsVisible="{Binding ParseError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="hint" Text="schedule run once · schedule every 5 minutes · schedule at 9:30 (local time). Tasks never run automatically: schedules are informational and a task only runs when you press Run now." />
          </StackPanel>
          <TextBox Classes="code" Text="{Binding NewTaskSource}"
                   AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" />
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Width="8" />

      <Grid Grid.Column="2" RowDefinitions="2*,8,*">
        <Border Grid.Row="0" Classes="pane">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="paneTitle" Margin="0,0,0,8">
              <Run Text="Scheduled tasks &amp; checks" /><Run Text=" " /><Run Text="{Binding Jobs.Count}" Foreground="{DynamicResource TextMutedBrush}" />
            </TextBlock>
            <Panel>
              <StackPanel Classes="emptyState" IsVisible="{Binding !Jobs.Count}">
                <PathIcon Data="{StaticResource Icon.tasks}" />
                <TextBlock Classes="emptyTitle" Text="No tasks yet" />
                <TextBlock Classes="emptyHint" Text="Write a Task block on the left and press Register." />
              </StackPanel>
              <ScrollViewer>
                <ItemsControl Name="JobsList" ItemsSource="{Binding Jobs}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TaskRowViewModel">
                      <Border Classes="row">
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                          <!-- Fill comes from the pass/fail converter; the class only sets the size. -->
                          <Ellipse Grid.Row="0" Grid.Column="0" Classes="dot" Margin="0,0,8,0"
                                   Fill="{Binding LastPassed, Converter={x:Static conv:PassFailBrushConverter.Instance}}" />
                          <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                            <Border Classes="badge"><TextBlock Text="{Binding Schedule}" /></Border>
                            <Border Classes="badge warn" IsVisible="{Binding !IsEnabled}"><TextBlock Text="paused" /></Border>
                            <Border Classes="badge ok" IsVisible="{Binding IsRunning}"><TextBlock Text="running" /></Border>
                          </StackPanel>
                          <WrapPanel Grid.Row="0" Grid.Column="2">
                            <Button Classes="small" Content="Run now" Margin="0,0,4,0"
                                    Command="{Binding #JobsList.DataContext.RunNowCommand}" CommandParameter="{Binding}" />
                            <Button Classes="small" Content="Pause / resume" Margin="0,0,4,0"
                                    Command="{Binding #JobsList.DataContext.ToggleEnabledCommand}" CommandParameter="{Binding}" />
                            <Button Classes="small" Content="Edit" Margin="0,0,4,0" ToolTip.Tip="Load this task's source into the editor"
                                    Command="{Binding #JobsList.DataContext.EditCommand}" CommandParameter="{Binding}" />
                            <Button Classes="small danger" Content="Remove"
                                    Command="{Binding #JobsList.DataContext.RemoveCommand}" CommandParameter="{Binding}" />
                          </WrapPanel>
                          <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="muted" Margin="0,4,0,0">
                            <Run Text="{Binding NextRun}" /><Run Text="   " /><Run Text="{Binding LastRun}" /><Run Text="   runs: " /><Run Text="{Binding RunCount}" /><Run Text="   failures: " /><Run Text="{Binding FailCount}" />
                          </TextBlock>
                          <SelectableTextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding LastResult}" FontSize="12"
                                               Margin="0,4,0,0" TextWrapping="Wrap"
                                               Foreground="{Binding LastPassed, Converter={x:Static conv:PassFailBrushConverter.Instance}}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Panel>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Row="1" ResizeDirection="Rows" Height="8" HorizontalAlignment="Stretch" />

        <Border Grid.Row="2" Classes="pane">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
              <TextBlock Grid.Column="0" Classes="paneTitle" Text="Run history" />
              <Button Grid.Column="1" Classes="small ghost" Content="Clear" Command="{Binding ClearHistoryCommand}" />
            </Grid>
            <Panel>
              <StackPanel Classes="emptyState" IsVisible="{Binding !History.Count}">
                <PathIcon Data="{StaticResource Icon.tasks}" />
                <TextBlock Classes="emptyTitle" Text="No runs yet" />
                <TextBlock Classes="emptyHint" Text="Press Run now on a task to see its result here." />
              </StackPanel>
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding History}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RunHistoryRow">
                      <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,3">
                        <TextBlock Grid.Column="0" Classes="muted mono" Text="{Binding When}" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" FontSize="12" FontWeight="Medium" Text="{Binding Name}" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="2" FontSize="12" Text="{Binding Detail}" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Detail}"
                                   Foreground="{Binding Passed, Converter={x:Static conv:PassFailBrushConverter.Instance}}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Panel>
          </DockPanel>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns" Width="8" IsVisible="{Binding IsHelpVisible}" />

      <Border Grid.Column="4" Classes="pane" Width="340" IsVisible="{Binding IsHelpVisible}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Classes="paneTitle" Text="KafScript help &amp; examples" />
            <Button Grid.Column="1" Classes="icon small ghost" Command="{Binding ToggleHelpCommand}" ToolTip.Tip="Close help">
              <PathIcon Data="{StaticResource Icon.close}" />
            </Button>
          </Grid>
          <ScrollViewer>
            <ItemsControl Name="HelpTopicsList" ItemsSource="{Binding HelpTopics}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="shared:HelpTopicViewModel">
                  <Border Classes="row">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" />
                      <SelectableTextBlock Text="{Binding Syntax}" Classes="mono muted" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" />
                      <SelectableTextBlock Text="{Binding Example}" Classes="mono muted" FontSize="11" TextWrapping="Wrap" />
                      <Button Classes="small" Content="Insert into editor" HorizontalAlignment="Left"
                              Command="{Binding #HelpTopicsList.DataContext.InsertExampleCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

    </Grid>
  </Grid>
</UserControl>
