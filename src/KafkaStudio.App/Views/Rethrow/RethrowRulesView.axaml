<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KafkaStudio.App.ViewModels.Rethrow"
             x:Class="KafkaStudio.App.Views.Rethrow.RethrowRulesView"
             x:DataType="vm:RethrowRulesViewModel">

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- Row 1: name, source -> destination, add. -->
    <Border Grid.Row="0" Classes="toolbar">
      <Grid ColumnDefinitions="*,Auto,Auto,*,Auto,Auto,*,Auto,Auto">
        <TextBox Grid.Column="0" MinWidth="110" Text="{Binding NewName}" Watermark="rule name" />

        <Border Grid.Column="1" Classes="sep" />

        <ComboBox Grid.Column="2" Width="150" PlaceholderText="source conn." ItemsSource="{Binding ConnectionNames}"
                  SelectedItem="{Binding NewSourceConnection}" ToolTip.Tip="Source connection" />
        <TextBox Grid.Column="3" MinWidth="120" Text="{Binding NewSourceTopic}" Watermark="source topic" />

        <TextBlock Grid.Column="4" Text="→" Classes="muted" FontSize="16" />

        <ComboBox Grid.Column="5" Width="150" PlaceholderText="destination conn." ItemsSource="{Binding ConnectionNames}"
                  SelectedItem="{Binding NewDestinationConnection}" ToolTip.Tip="Destination connection" />
        <TextBox Grid.Column="6" MinWidth="120" Text="{Binding NewDestinationTopic}" Watermark="destination topic" />

        <Border Grid.Column="7" Classes="sep" />

        <Button Grid.Column="8" Content="Add / update rule" Classes="primary" Command="{Binding AddRuleCommand}" Margin="0"
                ToolTip.Tip="Adds the rule (or replaces the stopped rule with the same name)" />
      </Grid>
    </Border>

    <!-- Row 2: optional filter, key handling, extra header. -->
    <Border Grid.Row="1" Classes="toolbar" Margin="0,6,0,0">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto">
        <TextBlock Grid.Column="0" Text="Only relay where" Classes="muted" />
        <ComboBox Grid.Column="1" Width="110" ItemsSource="{Binding FilterFieldOptions}" SelectedItem="{Binding NewFilterField}" />
        <TextBox Grid.Column="2" Width="120" Text="{Binding NewFilterPath}" Watermark="$.status" IsVisible="{Binding IsJsonFilter}" />
        <ComboBox Grid.Column="3" Width="110" ItemsSource="{Binding ComparatorOptions}" SelectedItem="{Binding NewFilterComparator}"
                  IsVisible="{Binding HasFilter}" />
        <TextBox Grid.Column="4" MinWidth="100" Text="{Binding NewFilterValue}" Watermark="value / regex" IsVisible="{Binding HasFilter}" />

        <Border Grid.Column="5" Classes="sep" />

        <CheckBox Grid.Column="6" Content="Keep key" IsChecked="{Binding NewKeepSourceKey}"
                  ToolTip.Tip="Relay with the source message's key (otherwise no key)" />
        <TextBlock Grid.Column="7" Text="Add header" Classes="muted" />
        <TextBox Grid.Column="8" Width="110" Text="{Binding NewHeaderName}" Watermark="name" />
        <TextBox Grid.Column="9" Width="120" Text="{Binding NewHeaderValue}" Watermark="value" Margin="0" />
      </Grid>
    </Border>

    <!-- Rules -->
    <Border Grid.Row="2" Classes="pane" Margin="0,8,0,0">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
          <TextBlock Grid.Column="0" Classes="paneTitle">
            <Run Text="Rules" /><Run Text=" " /><Run Text="{Binding Rules.Count}" Foreground="{DynamicResource TextMutedBrush}" />
          </TextBlock>
          <Button Grid.Column="1" Classes="small" Content="Start all" Command="{Binding StartAllCommand}" Margin="0,0,4,0" />
          <Button Grid.Column="2" Classes="small" Content="Stop all" Command="{Binding StopAllCommand}" />
        </Grid>
        <Panel>
          <StackPanel Classes="emptyState" MaxWidth="520" IsVisible="{Binding !Rules.Count}">
            <PathIcon Data="{StaticResource Icon.rethrow}" />
            <TextBlock Classes="emptyTitle" Text="No rules yet" />
            <TextBlock Classes="emptyHint"
                       Text="A rule continuously copies messages from a source topic to a destination topic (optionally filtered). Offsets are committed only after a message is relayed, so nothing is lost if the destination is briefly unavailable. Rules are saved; they always load stopped." />
          </StackPanel>
          <ScrollViewer>
            <ItemsControl Name="RulesList" ItemsSource="{Binding Rules}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RethrowRuleRowViewModel">
                  <Border Classes="row">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                      <Ellipse Grid.Row="0" Grid.Column="0" Classes="dot ok" Margin="0,0,8,0" IsVisible="{Binding IsRunning}" />
                      <Ellipse Grid.Row="0" Grid.Column="0" Classes="dot" Margin="0,0,8,0" IsVisible="{Binding IsStopped}" />
                      <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                        <Border Classes="badge ok" IsVisible="{Binding IsRunning}"><TextBlock Text="running" /></Border>
                      </StackPanel>
                      <WrapPanel Grid.Row="0" Grid.Column="2">
                        <Button Classes="small" Content="Start" Margin="0,0,4,0"
                                Command="{Binding #RulesList.DataContext.StartCommand}" CommandParameter="{Binding}" />
                        <Button Classes="small" Content="Stop" Margin="0,0,4,0"
                                Command="{Binding #RulesList.DataContext.StopCommand}" CommandParameter="{Binding}" />
                        <Button Classes="small" Content="Edit" Margin="0,0,4,0"
                                Command="{Binding #RulesList.DataContext.EditCommand}" CommandParameter="{Binding}" />
                        <Button Classes="small danger" Content="Remove"
                                Command="{Binding #RulesList.DataContext.RemoveCommand}" CommandParameter="{Binding}" />
                      </WrapPanel>
                      <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="muted" Margin="0,2,0,0" TextWrapping="Wrap">
                        <Run Text="{Binding Description}" /><Run Text="   ·   " /><Run Text="{Binding FilterDescription}" /><Run Text="   ·   " /><Run Text="{Binding KeyDescription}" />
                      </TextBlock>
                      <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Classes="muted" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                        <Run Text="relayed " /><Run Text="{Binding RelayedCount}" Foreground="{DynamicResource TextPrimaryBrush}" /><Run Text="   skipped " /><Run Text="{Binding SkippedCount}" Foreground="{DynamicResource TextPrimaryBrush}" /><Run Text="   " /><Run Text="{Binding LastActivity}" />
                      </TextBlock>
                      <SelectableTextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding LastError}"
                                           Classes="error" Margin="0,4,0,0" IsVisible="{Binding HasError}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Panel>
      </DockPanel>
    </Border>

    <Border Grid.Row="3" Classes="statusbar">
      <TextBlock Text="{Binding StatusMessage}" ToolTip.Tip="{Binding StatusMessage}" />
    </Border>
  </Grid>
</UserControl>
