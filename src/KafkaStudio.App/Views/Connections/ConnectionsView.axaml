<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KafkaStudio.App.ViewModels.Connections"
             x:Class="KafkaStudio.App.Views.Connections.ConnectionsView"
             x:DataType="vm:ConnectionsViewModel">

  <!-- Lives in the right-hand flyout, so it's laid out as a vertical form + list. -->
  <StackPanel Spacing="10">

    <!-- Existing connections -->
    <Border Classes="pane">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Classes="paneTitle">
            <Run Text="Connections" /><Run Text=" " /><Run Text="{Binding Connections.Count}" Foreground="{DynamicResource TextMutedBrush}" />
          </TextBlock>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <Button Classes="small" Content="Import..." Command="{Binding ImportConnectionsCommand}"
                    ToolTip.Tip="Add connections from an exported JSON file (same names are replaced)" />
            <Button Classes="small" Content="Export..." Command="{Binding ExportConnectionsCommand}"
                    ToolTip.Tip="Save all connections to a JSON file to share or move to another machine" />
          </StackPanel>
        </Grid>
        <CheckBox Content="Include passwords in export (plain text)" IsChecked="{Binding ExportIncludesPasswords}" />
        <StackPanel Classes="emptyState" IsVisible="{Binding !Connections.Count}">
          <PathIcon Data="{StaticResource Icon.plug}" />
          <TextBlock Classes="emptyTitle" Text="No connections yet" />
          <TextBlock Classes="emptyHint" Text="Add a real cluster below, or a demo (in-memory) connection to try KafkaStudio without a broker." />
        </StackPanel>
        <ItemsControl Name="ConnectionsList" ItemsSource="{Binding Connections}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ConnectionRowViewModel">
              <Border Classes="row">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                  <Ellipse Grid.Row="0" Grid.Column="0" Classes="dot ok" Margin="0,0,8,0" IsVisible="{Binding IsConnected}" />
                  <Ellipse Grid.Row="0" Grid.Column="0" Classes="dot bad" Margin="0,0,8,0" IsVisible="{Binding !IsConnected}" />
                  <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                    <Border Classes="badge accent"><TextBlock Text="{Binding Kind}" /></Border>
                  </StackPanel>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BootstrapServers}" Classes="muted mono" TextTrimming="CharacterEllipsis" />
                  <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4" Margin="0,4,0,0">
                    <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" MaxHeight="64"
                               Classes.error="{Binding HasError}" />
                    <WrapPanel>
                      <Button Classes="small" Content="Test" Margin="0,0,4,0"
                              Command="{Binding #ConnectionsList.DataContext.TestConnectionCommand}" CommandParameter="{Binding}" />
                      <Button Classes="small" Content="Reconnect" Margin="0,0,4,0"
                              Command="{Binding #ConnectionsList.DataContext.ReconnectCommand}" CommandParameter="{Binding}" />
                      <Button Classes="small" Content="Edit" Margin="0,0,4,0"
                              Command="{Binding #ConnectionsList.DataContext.EditConnectionCommand}" CommandParameter="{Binding}" />
                      <Button Classes="small danger" Content="Remove"
                              Command="{Binding #ConnectionsList.DataContext.RemoveConnectionCommand}" CommandParameter="{Binding}" />
                    </WrapPanel>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Add / edit form -->
    <Border Classes="pane">
      <StackPanel Classes="form" Spacing="2">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Classes="paneTitle" Text="Add or edit a connection" />
          <Button Grid.Column="1" Classes="small ghost" Content="Clear form" Command="{Binding ResetFormCommand}" />
        </Grid>

        <TextBlock Classes="label" Text="NAME" />
        <TextBox Text="{Binding NewConnectionName}" Watermark="e.g. local, staging-eu" />
        <TextBlock Classes="hint" Text="A connection with this name already exists - saving will replace it."
                   IsVisible="{Binding IsEditingExisting}" />

        <TextBlock Classes="label" Text="BOOTSTRAP SERVERS" />
        <TextBox Text="{Binding NewBootstrapServers}" Watermark="host:9092,host2:9092" />

        <TextBlock Classes="label" Text="SECURITY PROTOCOL" />
        <ComboBox ItemsSource="{Binding SecurityProtocolOptions}" SelectedItem="{Binding NewSecurityProtocol}" HorizontalAlignment="Stretch" />

        <StackPanel Spacing="2" IsVisible="{Binding UsesSasl}">
          <TextBlock Classes="label" Text="SASL MECHANISM" Margin="0,6,0,2" />
          <ComboBox ItemsSource="{Binding SaslMechanismOptions}" SelectedItem="{Binding NewSaslMechanism}" HorizontalAlignment="Stretch" />
          <TextBlock Classes="label" Text="USERNAME" Margin="0,6,0,2" />
          <TextBox Text="{Binding NewSaslUsername}" />
          <TextBlock Classes="label" Text="PASSWORD" Margin="0,6,0,2" />
          <TextBox Text="{Binding NewSaslPassword}" PasswordChar="•" RevealPassword="{Binding #RevealPassword.IsChecked}" />
          <CheckBox Name="RevealPassword" Content="Show password" />
        </StackPanel>

        <StackPanel Spacing="2" IsVisible="{Binding UsesSsl}">
          <TextBlock Classes="label" Text="CA CERTIFICATE (OPTIONAL)" Margin="0,6,0,2" />
          <TextBox Text="{Binding NewSslCaLocation}" Watermark="path to CA .pem for a private CA" />
          <CheckBox Content="Skip certificate verification (dev clusters only)" IsChecked="{Binding NewSslSkipVerification}" />
        </StackPanel>

        <Expander Header="Advanced" Margin="0,8,0,0" HorizontalAlignment="Stretch">
          <StackPanel Classes="form" Spacing="2">
            <TextBlock Classes="label" Text="CLIENT ID" />
            <TextBox Text="{Binding NewClientId}" />
            <TextBlock Classes="label" Text="EXTRA LIBRDKAFKA SETTINGS (key=value per line)" />
            <TextBox Classes="code" Text="{Binding NewAdvancedProperties}" AcceptsReturn="True" MinHeight="70" TextWrapping="NoWrap"
                     Watermark="socket.timeout.ms=30000&#x0a;ssl.certificate.location=/path/client.pem" />
          </StackPanel>
        </Expander>

        <WrapPanel Margin="0,10,0,0">
          <Button Content="Save &amp; connect" Classes="primary" Command="{Binding AddConnectionCommand}" Margin="0,0,6,0"
                  ToolTip.Tip="Connects and lists topics to verify the settings before saving" />
          <Button Content="Add as demo (in-memory)" Command="{Binding AddDemoConnectionCommand}"
                  ToolTip.Tip="A simulated broker inside the app - try every screen and script without Kafka" />
          <ProgressBar Classes="busy" IsVisible="{Binding IsBusy}" Margin="8,0,0,0" />
        </WrapPanel>
        <TextBlock Classes="hint" Text="{Binding StatusMessage}" Margin="0,6,0,0"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Classes="hint" Margin="0,6,0,0"
                   Text="Saved in your user profile. On Windows, SASL passwords are encrypted for your account." />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
