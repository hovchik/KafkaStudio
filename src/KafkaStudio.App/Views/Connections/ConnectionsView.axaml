<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:KafkaStudio.App.ViewModels.Connections"
			 x:Class="KafkaStudio.App.Views.Connections.ConnectionsView"
			 x:DataType="vm:ConnectionsViewModel">

  <Grid RowDefinitions="Auto,Auto,*">

	<!-- Single-line toolbar: the common case is name + servers + connect. -->
	<Border Grid.Row="0" Classes="toolbar">
	  <Grid ColumnDefinitions="*,2*,Auto,Auto,Auto,*">
		<TextBox Grid.Column="0" MinWidth="120" Text="{Binding NewConnectionName}" Watermark="Name, e.g. Staging" />
		<TextBox Grid.Column="1" MinWidth="180" Text="{Binding NewBootstrapServers}" Watermark="host:9092,host2:9092" />

		<Border Grid.Column="2" Classes="sep" />

		<Button Grid.Column="3" Content="Connect" Classes="primary" Command="{Binding AddConnectionCommand}" />
		<Button Grid.Column="4" Content="Add demo" Command="{Binding AddDemoConnectionCommand}"
				ToolTip.Tip="Add a demo (in-memory) connection to try KafkaStudio without a broker" />
		<TextBlock Grid.Column="5" Classes="muted" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
	  </Grid>
	</Border>

	<!-- Security settings are needed rarely, so they stay collapsed. -->
	<Expander Grid.Row="1" Header="Security — SASL / SSL" Margin="0,4,0,0">
	  <Border Classes="toolbar" Margin="0,4,0,0">
		<Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*">
		  <TextBlock Grid.Column="0" Text="Protocol" Classes="muted" />
		  <ComboBox Grid.Column="1" ItemsSource="{Binding SecurityProtocolOptions}"
					SelectedItem="{Binding NewSecurityProtocol}" HorizontalAlignment="Stretch" />
		  <TextBlock Grid.Column="2" Text="Mechanism" Classes="muted" />
		  <ComboBox Grid.Column="3" ItemsSource="{Binding SaslMechanismOptions}"
					SelectedItem="{Binding NewSaslMechanism}" HorizontalAlignment="Stretch" />
		  <TextBlock Grid.Column="4" Text="Username" Classes="muted" />
		  <TextBox Grid.Column="5" Text="{Binding NewSaslUsername}" Watermark="optional" />
		  <TextBlock Grid.Column="6" Text="Password" Classes="muted" />
		  <TextBox Grid.Column="7" Text="{Binding NewSaslPassword}" Watermark="optional" PasswordChar="*" />
		</Grid>
	  </Border>
	</Expander>

	<!-- Data area fills everything else. -->
	<Border Grid.Row="2" Classes="pane" Margin="0,6,0,0">
	  <DockPanel>
		<TextBlock DockPanel.Dock="Top" Classes="paneTitle" Margin="0,0,0,6">
		  <Run Text="Connections" /><Run Text=" " /><Run Text="{Binding Connections.Count}" Foreground="{DynamicResource MutedTextBrush}" />
		</TextBlock>
		<ScrollViewer>
		  <ItemsControl Name="ConnectionsList" ItemsSource="{Binding Connections}">
			<ItemsControl.ItemTemplate>
			  <DataTemplate x:DataType="vm:ConnectionRowViewModel">
				<Border Classes="row">
				  <Grid ColumnDefinitions="*,Auto,Auto,Auto">
					<StackPanel Grid.Column="0" Spacing="1">
					  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White" FontSize="12" />
					  <TextBlock Text="{Binding BootstrapServers}" Classes="muted" />
					</StackPanel>
					<TextBlock Grid.Column="1" Text="{Binding Status}" Classes="muted" VerticalAlignment="Center" Margin="0,0,12,0" />
					<Button Grid.Column="2" Content="Test" Padding="8,2" Margin="0,0,6,0"
							Command="{Binding #ConnectionsList.DataContext.TestConnectionCommand}"
							CommandParameter="{Binding}" />
					<Button Grid.Column="3" Content="Remove" Padding="8,2"
							Command="{Binding #ConnectionsList.DataContext.RemoveConnectionCommand}"
							CommandParameter="{Binding}" />
				  </Grid>
				</Border>
			  </DataTemplate>
			</ItemsControl.ItemTemplate>
		  </ItemsControl>
		</ScrollViewer>
	  </DockPanel>
	</Border>
  </Grid>
</UserControl>
