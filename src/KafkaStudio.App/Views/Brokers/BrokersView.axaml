<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KafkaStudio.App.ViewModels.Brokers"
             xmlns:msg="using:KafkaStudio.Core.Messaging"
             x:Class="KafkaStudio.App.Views.Brokers.BrokersView"
             x:DataType="vm:BrokersViewModel">

  <Grid RowDefinitions="Auto,Auto,*">

    <Border Grid.Row="0" Classes="toolbar">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ComboBox Width="200" PlaceholderText="connection" ItemsSource="{Binding ConnectionNames}"
                  SelectedItem="{Binding SelectedConnection}" />
        <Button Content="Refresh" Command="{Binding RefreshCommand}" />
        <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding ClusterSummary}" />
      </StackPanel>
    </Border>

    <TextBlock Grid.Row="1" Classes="hint" Margin="4,6" Text="{Binding Status}" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <Grid Grid.Row="2" ColumnDefinitions="*,6,*" Margin="0,6,0,0">

      <Border Grid.Column="0" Classes="pane">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="paneTitle" Text="Brokers" Margin="0,0,0,6" />
          <Panel>
            <TextBlock Classes="hint" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="Pick a connection to see its brokers." IsVisible="{Binding !Brokers.Count}" />
            <ListBox Classes="rows" ItemsSource="{Binding Brokers}" SelectedItem="{Binding SelectedBroker}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="msg:BrokerInfo">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding Id, StringFormat='#{0}'}" FontWeight="SemiBold" Foreground="White" Width="36" />
                    <TextBlock Classes="mono" Text="{Binding Address}" MinWidth="180" />
                    <TextBlock Classes="muted" Text="{Binding Rack, StringFormat='rack {0}'}" IsVisible="{Binding Rack, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Border Classes="badge ok" IsVisible="{Binding IsController}"><TextBlock Text="controller" /></Border>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Panel>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" />

      <Border Grid.Column="2" Classes="pane">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,6">
            <TextBlock Grid.Column="0" Classes="paneTitle" Text="Configuration" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox Grid.Column="1" Watermark="filter by name or value" Text="{Binding ConfigFilter}" IsEnabled="{Binding HasSelectedBroker}" />
          </Grid>
          <ListBox Classes="rows" ItemsSource="{Binding Config}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="msg:BrokerConfigEntry">
                <Grid ColumnDefinitions="2*,2*,Auto" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Classes="mono" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                  <TextBlock Grid.Column="1" Classes="mono" Foreground="White" Text="{Binding Value}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Value}" />
                  <TextBlock Grid.Column="2" Classes="muted" Text="{Binding Source}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
