<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KafkaStudio.App.ViewModels.Brokers"
             xmlns:msg="using:KafkaStudio.Core.Messaging"
             x:Class="KafkaStudio.App.Views.Brokers.BrokersView"
             x:DataType="vm:BrokersViewModel">

  <Grid RowDefinitions="Auto,Auto,*">

    <Border Grid.Row="0" Classes="toolbar">
      <Grid ColumnDefinitions="Auto,Auto,*">
        <ComboBox Grid.Column="0" Width="200" PlaceholderText="Connection…" ItemsSource="{Binding ConnectionNames}"
                  SelectedItem="{Binding SelectedConnection}" ToolTip.Tip="Connection" />
        <Button Grid.Column="1" Classes="icon" ToolTip.Tip="Refresh brokers" Command="{Binding RefreshCommand}">
          <PathIcon Data="{StaticResource Icon.refresh}" />
        </Button>
        <TextBlock Grid.Column="2" Classes="muted" Text="{Binding ClusterSummary}" TextTrimming="CharacterEllipsis" Margin="0" />
      </Grid>
    </Border>

    <TextBlock Grid.Row="1" Classes="hint" Margin="4,8,4,0" Text="{Binding Status}"
               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <Grid Grid.Row="2" ColumnDefinitions="*,8,*" Margin="0,8,0,0">

      <Border Grid.Column="0" Classes="pane">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="paneTitle" Text="Brokers" Margin="0,0,0,8" />
          <Panel>
            <StackPanel Classes="emptyState" IsVisible="{Binding !Brokers.Count}">
              <PathIcon Data="{StaticResource Icon.brokers}" />
              <TextBlock Classes="emptyTitle" Text="No brokers to show" />
              <TextBlock Classes="emptyHint" Text="Pick a connection to see its brokers." />
            </StackPanel>
            <ListBox Classes="rows" ItemsSource="{Binding Brokers}" SelectedItem="{Binding SelectedBroker}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="msg:BrokerInfo">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding Id, StringFormat='#{0}'}" Classes="mono" FontWeight="SemiBold" Width="36" VerticalAlignment="Center" />
                    <TextBlock Classes="mono" Text="{Binding Address}" MinWidth="180" VerticalAlignment="Center" />
                    <TextBlock Classes="muted" Text="{Binding Rack, StringFormat='rack {0}'}" VerticalAlignment="Center"
                               IsVisible="{Binding Rack, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Border Classes="badge ok" IsVisible="{Binding IsController}"><TextBlock Text="controller" /></Border>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Panel>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Width="8" />

      <Border Grid.Column="2" Classes="pane">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Classes="paneTitle" Text="Configuration" Margin="0,0,10,0" />
            <TextBox Grid.Column="1" Watermark="Filter by name or value" Text="{Binding ConfigFilter}" IsEnabled="{Binding HasSelectedBroker}" />
          </Grid>
          <Border DockPanel.Dock="Top" Classes="tableHeader" IsVisible="{Binding HasSelectedBroker}">
            <Grid ColumnDefinitions="2*,2*,150">
              <TextBlock Grid.Column="0" Text="NAME" />
              <TextBlock Grid.Column="1" Text="VALUE" />
              <TextBlock Grid.Column="2" Text="SOURCE" />
            </Grid>
          </Border>
          <Panel>
            <StackPanel Classes="emptyState" IsVisible="{Binding !HasSelectedBroker}">
              <PathIcon Data="{StaticResource Icon.info}" />
              <TextBlock Classes="emptyTitle" Text="No broker selected" />
              <TextBlock Classes="emptyHint" Text="Select a broker to see its configuration." />
            </StackPanel>
            <ListBox Classes="rows" ItemsSource="{Binding Config}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="msg:BrokerConfigEntry">
                  <Grid ColumnDefinitions="2*,2*,150">
                    <TextBlock Grid.Column="0" Margin="0,0,10,0" Classes="mono" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                    <TextBlock Grid.Column="1" Margin="0,0,10,0" Classes="mono" Text="{Binding Value}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Value}" />
                    <TextBlock Grid.Column="2" Classes="muted" Text="{Binding Source}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Source}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Panel>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
