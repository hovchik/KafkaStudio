<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KafkaStudio.App.App"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://KafkaStudio.App/Styles/Theme.axaml" />
  </Application.Styles>

  <Application.DataTemplates>
    <local:ViewLocator xmlns:local="using:KafkaStudio.App" />
  </Application.DataTemplates>

</Application>
