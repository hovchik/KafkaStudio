      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#F5F6FA" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#D4D9E3" />
