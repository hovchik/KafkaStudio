      <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F1F3F8" />
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E6E9F0" />
      <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#F5F6FA" />
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="#D4D9E3" />
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#B9C1D0" />
      <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#B9C1D0" />
