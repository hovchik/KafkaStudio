<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <Color x:Key="AppBackgroundColor">#1E1F24</Color>
    <Color x:Key="SidebarColor">#17181C</Color>
    <Color x:Key="ContentBackgroundColor">#1E1F24</Color>
    <Color x:Key="CardColor">#2A2C33</Color>
    <Color x:Key="AccentColor">#6E8BFF</Color>
    <Color x:Key="SuccessColor">#4CD97B</Color>
    <Color x:Key="FailureColor">#FF6B6B</Color>
    <Color x:Key="MutedTextColor">#9AA0AC</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{StaticResource ContentBackgroundColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="FailureBrush" Color="{StaticResource FailureColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
  </Styles.Resources>

  <Style Selector="ListBoxItem">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style Selector="Expander">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
    <Setter Property="Background" Value="{DynamicResource SidebarBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource SidebarBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="Border.chip.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="#332A3550" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="TextBlock.status-passed">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.status-failed">
    <Setter Property="Foreground" Value="{DynamicResource FailureBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- ===== Shared "workbench" layout language =====
       A view is built from one compact Border.toolbar line of inputs/actions followed by
       Border.pane data areas that fill all remaining space. Keep chrome small, data large. -->

  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8,5" />
  </Style>

  <Style Selector="Border.toolbar TextBox">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.toolbar ComboBox">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.toolbar AutoCompleteBox">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.toolbar NumericUpDown">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.toolbar Button">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.toolbar CheckBox">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.toolbar TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>

  <!-- Thin vertical rule used to group the toolbar into sections. -->
  <Style Selector="Border.sep">
    <Setter Property="Width" Value="1" />
    <Setter Property="Background" Value="#33FFFFFF" />
    <Setter Property="Margin" Value="2,2,8,2" />
  </Style>

  <Style Selector="Border.pane">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8" />
  </Style>

  <Style Selector="TextBlock.paneTitle">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Row/card used for every list item inside a pane. -->
  <Style Selector="Border.row">
    <Setter Property="Background" Value="{DynamicResource SidebarBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <Style Selector="Border.mono">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

</Styles>
